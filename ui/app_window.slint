import { Button, LineEdit, ListView, TabWidget } from "std-widgets.slint";

export struct NetworkDevice {
    name: string,
    ip: string,
    mac: string,
    vendor: string,
    device-type: string,
    is-online: bool,
    latency: string,
    traffic: string,
}

export struct ActiveConnection {
    process-name: string,
    pid: int,
    local-addr: string,
    remote-addr: string,
    protocol: string,
    state: string,
    is-safe: bool,
}

export struct AppConnectionGroup {
    process-name: string,
    pid: int,
    connection-count: int,
    destinations-summary: string,
    protocol-summary: string,
    state-summary: string,
    is-safe: bool,
}

export struct LogEntry {
    timestamp: string,
    domain: string,
    source-ip: string,
    is-blocked: bool,
}

export struct DomainLogGroup {
    domain: string,
    total-queries: int,
    blocked-queries: int,
    is-blocked: bool,
    last-seen: string,
    last-ip: string,
}

export struct ConsoleLogEntry {
    time: string,
    level: string,
    message: string,
}

export component AppWindow inherits Window {
    title: root.is-vi ? "Shield Ghita v0.0.1 - Trình Điều Khiển Mạng Tối Cao" : "Shield Ghita v0.0.1 - Master Internet Controller";
    width: 1120px;
    height: 780px;
    background: #0f172a;
    default-font-family: "Segoe UI, Tahoma, Geneva, Verdana, sans-serif";

    in-out property <bool> is-vi: true;
    in-out property <bool> enable-notifications: true;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-domain: "";
    in-out property <string> toast-time: "";
    in-out property <string> app-version: "0.0.1";

    in-out property <string> status-text: "Đang hoạt động";
    in-out property <int> blocked-count: 0;
    in-out property <int> total-queries: 0;
    in-out property <int> absorbed-count: 0;
    in-out property <int> active-rules-count: 0;
    in-out property <float> cpu-usage: 0.0;
    in-out property <float> mem-usage: 0.0;
    in-out property <bool> protection-enabled: true;
    in-out property <bool> master-locked: false;
    in-out property <bool> silent-sinkhole: true;
    in-out property <bool> autostart-enabled: true;
    in-out property <bool> minimize-to-tray-enabled: true;
    in-out property <string> last-update-text: "Chưa cập nhật";
    in-out property <string> live-traffic-rate: "0 KB/s";
    in-out property <[NetworkDevice]> devices;
    in-out property <[ActiveConnection]> connections;
    in-out property <[AppConnectionGroup]> grouped-connections;
    in-out property <[LogEntry]> logs;
    in-out property <[DomainLogGroup]> grouped-logs;
    in-out property <[ConsoleLogEntry]> console-logs;
    in-out property <[string]> custom-rules;
    in-out property <[string]> allowed-rules;
    in-out property <int> active-log-view: 0;
    in-out property <int> conn-view-mode: 1;
    in-out property <int> log-view-mode: 0;

    callback toggle-protection(bool);
    callback toggle-master-lock(bool);
    callback toggle-silent-sinkhole(bool);
    callback toggle-autostart(bool);
    callback toggle-minimize-to-tray(bool);
    callback toggle-notifications(bool);
    callback change-language(string);
    callback refresh-devices();
    callback refresh-connections();
    callback clear-logs();
    callback clear-console-logs();
    callback add-custom-rule(string);
    callback remove-custom-rule(string);
    callback add-allowed-rule(string);
    callback remove-allowed-rule(string);
    callback update-blocklist();
    callback export-logs();
    callback filter-logs(string, string, int);
    callback dismiss-toast();

    // Floating Notification Toast
    if root.show-toast : Rectangle {
        z: 100;
        x: root.width - 390px;
        y: 60px;
        width: 370px;
        height: 68px;
        background: #1e1b4b;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: #818cf8;
        drop-shadow-color: #00000088;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 16px;

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: center;

            Text {
                text: "🛡️";
                font-size: 24px;
                vertical-alignment: center;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.is-vi ? "ĐÃ CHẶN QUẢNG CÁO & THEO DÕI" : "AD & TRACKER BLOCKED";
                    font-size: 11px;
                    font-weight: 800;
                    color: #a5b4fc;
                }
                Text {
                    text: root.toast-domain + " (" + root.toast-time + ")";
                    font-size: 12px;
                    font-weight: 700;
                    color: #ffffff;
                    overflow: elide;
                }
            }

            Button {
                text: "✖";
                width: 30px;
                clicked => { root.dismiss-toast(); }
            }
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Navigation Header
        HorizontalLayout {
            spacing: 16px;
            alignment: center;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Image {
                    source: @image-url("assets/logo.png");
                    width: 30px;
                    height: 30px;
                }
                Text {
                    text: "Shield Ghita";
                    font-size: 22px;
                    font-weight: 800;
                    color: #38bdf8;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: root.is-vi ? 150px : 160px;
                    height: 26px;
                    border-radius: 13px;
                    background: root.master-locked ? #7f1d1d : (root.protection-enabled ? #166534 : #991b1b);
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.master-locked ? (root.is-vi ? "🔒 ĐÃ KHÓA MẠNG" : "🔒 LOCKED") : (root.protection-enabled ? (root.is-vi ? "🟢 BẢO VỆ TỐI CAO" : "🟢 ACTIVE SHIELD") : (root.is-vi ? "🔴 TẠM DỪNG" : "🔴 PAUSED"));
                            font-size: 11px;
                            font-weight: 800;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: 14px;
                alignment: end;
                Text {
                    text: (root.is-vi ? "🎯 Quy tắc: " : "🎯 Rules: ") + root.active-rules-count;
                    font-size: 12px;
                    font-weight: 700;
                    color: #38bdf8;
                    vertical-alignment: center;
                }
                Rectangle { width: 1px; height: 16px; background: #334155; }
                Text {
                    text: "⚡ " + root.live-traffic-rate;
                    font-size: 12px;
                    font-weight: 700;
                    color: #22c55e;
                    vertical-alignment: center;
                }
                Rectangle { width: 1px; height: 16px; background: #334155; }
                Text {
                    text: (root.is-vi ? "🤫 Phát nền: " : "🤫 Silent: ") + root.absorbed-count;
                    font-size: 12px;
                    font-weight: 600;
                    color: #a78bfa;
                    vertical-alignment: center;
                }
                Rectangle { width: 1px; height: 16px; background: #334155; }
                Text {
                    text: "CPU: " + Math.round(root.cpu-usage) + "% | RAM: " + (Math.round(root.mem-usage * 10) / 10) + " GB";
                    font-size: 12px;
                    color: #94a3b8;
                    vertical-alignment: center;
                }
            }
        }

        TabWidget {
            vertical-stretch: 1;

            // Tab 1: Dashboard
            Tab {
                title: root.is-vi ? "📊 Tổng quan & Điều khiển" : "📊 Dashboard & Controls";
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: #1e293b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #334155;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.is-vi ? "TỔNG TRUY VẤN DNS" : "TOTAL DNS QUERIES"; font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: root.total-queries; font-size: 26px; font-weight: 800; color: #f8fafc; }
                                Text { text: root.is-vi ? "Toàn bộ lưu lượng máy" : "All device DNS traffic"; font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            background: #1e293b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #334155;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.is-vi ? "QUẢNG CÁO & THEO DÕI ĐÃ CHẶN" : "ADS & TRACKERS BLOCKED"; font-size: 11px; font-weight: 700; color: #f87171; }
                                Text { text: root.blocked-count; font-size: 26px; font-weight: 800; color: #ef4444; }
                                Text { text: root.is-vi ? "Khử rò rỉ dữ liệu ngầm" : "Zero tracking leakage"; font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            background: #1e293b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #334155;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.is-vi ? "QUY TẮC BỘ LỌC ĐANG CHẶN" : "ACTIVE FILTER RULES"; font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: root.active-rules-count; font-size: 26px; font-weight: 800; color: #38bdf8; }
                                Text { text: root.is-vi ? "Domain trong cơ sở dữ liệu" : "Domains in active memory"; font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            background: #1e293b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #334155;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.is-vi ? "PHÁT NỀN ÊM DỊU (SILENT ADS)" : "SILENT SINKHOLE ADS"; font-size: 11px; font-weight: 700; color: #c084fc; }
                                Text { text: root.absorbed-count; font-size: 26px; font-weight: 800; color: #a855f7; }
                                Text { text: root.is-vi ? "Nuốt chửng ad không gây lag" : "Smooth media absorption"; font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            background: #1e293b;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #334155;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.is-vi ? "TỶ LỆ LỌC THÀNH CÔNG" : "BLOCKING RATIO"; font-size: 11px; font-weight: 700; color: #4ade80; }
                                Text {
                                    text: root.total-queries > 0 ? (Math.round(root.blocked-count * 10000 / root.total-queries) / 100) + "%" : "0%";
                                    font-size: 26px;
                                    font-weight: 800;
                                    color: #22c55e;
                                }
                                Text { text: root.is-vi ? "Bảo vệ an toàn tối cao" : "Ultra-fast response"; font-size: 11px; color: #64748b; }
                            }
                        }
                    }

                    Rectangle {
                        background: #1e293b;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #334155;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text { text: root.is-vi ? "⚡ Trung tâm điều khiển Internet tối cao (Master Controller):" : "⚡ Master Internet Controller Quick Actions:"; font-size: 14px; font-weight: 700; color: #e2e8f0; }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    text: root.protection-enabled ? (root.is-vi ? "⏸️ Tạm dừng bảo vệ" : "⏸️ Pause Protection") : (root.is-vi ? "▶️ Bật bảo vệ tối cao" : "▶️ Enable Protection");
                                    clicked => { root.toggle-protection(!root.protection-enabled); }
                                }
                                Button {
                                    text: root.master-locked ? (root.is-vi ? "🔓 Mở khóa Internet" : "🔓 Unlock Internet") : (root.is-vi ? "🔒 Khóa toàn bộ Internet (Kill Switch)" : "🔒 Master Internet Lock (Kill Switch)");
                                    clicked => { root.toggle-master-lock(!root.master-locked); }
                                }
                                Button {
                                    text: root.silent-sinkhole ? (root.is-vi ? "🤫 Chế độ: Phát nền êm dịu (Bật)" : "🤫 Mode: Silent Sinkhole (ON)") : (root.is-vi ? "🚫 Chế độ: Chặn NXDOMAIN" : "🚫 Mode: NXDOMAIN Block");
                                    clicked => { root.toggle-silent-sinkhole(!root.silent-sinkhole); }
                                }
                                Button {
                                    text: root.is-vi ? "🔄 Cập nhật bộ lọc Online" : "🔄 Update Blocklists Online";
                                    clicked => { root.update-blocklist(); }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Tab 2: Connections
            Tab {
                title: root.is-vi ? "🌐 Kết nối Internet của máy" : "🌐 Active Connections";
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: root.is-vi ? "🔄 Làm mới" : "🔄 Refresh";
                            clicked => { root.refresh-connections(); }
                        }
                        Button {
                            text: root.conn-view-mode == 1 ? (root.is-vi ? "📄 Chuyển sang Xem Chi Tiết" : "📄 View Detailed List") : (root.is-vi ? "🚀 Chuyển sang Gom Nhóm Ứng Dụng" : "🚀 Group by Application");
                            clicked => { root.conn-view-mode = root.conn-view-mode == 1 ? 0 : 1; }
                        }
                        Text {
                            text: root.conn-view-mode == 1 ? (root.is-vi ? "Gom nhóm theo Ứng dụng / Tiến trình:" : "Grouped by Application / Process:") : (root.is-vi ? "Chi tiết tất cả kết nối mạng trực tiếp:" : "Detailed direct network connections:");
                            font-size: 13px;
                            font-weight: 600;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                    }

                    if root.conn-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for grp in root.grouped-connections : Rectangle {
                            height: 42px;
                            background: #1e293b;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + grp.process-name; font-size: 13px; font-weight: 700; color: #38bdf8; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + grp.pid; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #0284c7;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: grp.connection-count + (root.is-vi ? " kết nối" : " conns"); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Text { text: grp.protocol-summary; font-size: 11px; font-weight: 700; color: #a78bfa; vertical-alignment: center; min-width: 55px; }
                                Text { text: "➔ " + grp.destinations-summary; font-size: 12px; color: #cbd5e1; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: grp.state-summary; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.conn-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for conn in root.connections : Rectangle {
                            height: 38px;
                            background: #1e293b;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + conn.process-name; font-size: 13px; font-weight: 700; color: #38bdf8; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + conn.pid; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }
                                Text { text: conn.protocol; font-size: 11px; font-weight: 700; color: #a78bfa; vertical-alignment: center; min-width: 45px; }
                                Text { text: conn.local-addr; font-size: 12px; color: #94a3b8; vertical-alignment: center; min-width: 150px; }
                                Text { text: "➔"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                                Text { text: conn.remote-addr; font-size: 12px; color: #f1f5f9; vertical-alignment: center; min-width: 170px; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: conn.state; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Tab 3: LAN Scanner
            Tab {
                title: root.is-vi ? "💻 Thiết bị chung mạng LAN" : "💻 LAN Devices Scanner";
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: root.is-vi ? "🔍 Quét toàn bộ mạng LAN" : "🔍 Scan Entire LAN Subnet";
                            clicked => { root.refresh-devices(); }
                        }
                        Text {
                            text: root.is-vi ? "Quét chủ động toàn bộ dải mạng LAN /24 qua Layer 2 ARP & tra cứu Vendor/NetBIOS:" : "Active Layer 2 ARP subnet sweep (/24) with Vendor/NetBIOS hardware identification:";
                            font-size: 13px;
                            font-weight: 600;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for device in root.devices : Rectangle {
                            height: 52px;
                            background: #1e293b;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 280px;
                                    Text { text: device.name; font-size: 13px; font-weight: 700; color: #f1f5f9; }
                                    Text { text: (root.is-vi ? "Hãng: " : "Vendor: ") + device.vendor; font-size: 11px; color: #38bdf8; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 170px;
                                    Text { text: "IP: " + device.ip; font-size: 12px; color: #cbd5e1; }
                                    Text { text: "MAC: " + device.mac; font-size: 11px; color: #64748b; }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: device.is-online ? (root.is-vi ? "🟢 TRỰC TUYẾN" : "🟢 ONLINE") : (root.is-vi ? "🔴 NGOẠI TUYẾN" : "🔴 OFFLINE");
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: device.is-online ? #4ade80 : #f87171;
                                    }
                                    Text { text: (root.is-vi ? "Độ trễ: " : "Latency: ") + device.latency; font-size: 11px; color: #94a3b8; }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 4: Rules & Whitelist
            Tab {
                title: root.is-vi ? "🚫 Quy tắc lọc & Whitelist" : "🚫 Rules & Whitelist";
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;

                        Text { text: root.is-vi ? "⛔ Danh sách chặn tùy chỉnh (Blacklist):" : "⛔ Custom Blacklist (Block):"; font-size: 14px; font-weight: 700; color: #f87171; }
                        HorizontalLayout {
                            spacing: 8px;
                            block-input := LineEdit {
                                placeholder-text: root.is-vi ? "Nhập domain muốn chặn..." : "Enter domain to block...";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.is-vi ? "➕ Chặn" : "➕ Block";
                                clicked => {
                                    root.add-custom-rule(block-input.text);
                                    block-input.text = "";
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for rule in root.custom-rules : Rectangle {
                                height: 36px;
                                background: #1e293b;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    Text { text: "🚫 " + rule; font-size: 12px; color: #fca5a5; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button {
                                        text: root.is-vi ? "Xóa" : "Delete";
                                        clicked => { root.remove-custom-rule(rule); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: #334155; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;

                        Text { text: root.is-vi ? "✅ Danh sách cho phép (Whitelist - Ưu tiên cao nhất):" : "✅ Whitelist (Always Allow - Highest Priority):"; font-size: 14px; font-weight: 700; color: #4ade80; }
                        HorizontalLayout {
                            spacing: 8px;
                            allow-input := LineEdit {
                                placeholder-text: root.is-vi ? "Nhập domain luôn cho phép..." : "Enter domain to always allow...";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.is-vi ? "➕ Cho phép" : "➕ Allow";
                                clicked => {
                                    root.add-allowed-rule(allow-input.text);
                                    allow-input.text = "";
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for rule in root.allowed-rules : Rectangle {
                                height: 36px;
                                background: #1e293b;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    Text { text: "✅ " + rule; font-size: 12px; color: #86efac; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button {
                                        text: root.is-vi ? "Xóa" : "Delete";
                                        clicked => { root.remove-allowed-rule(rule); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 5: Logs & Console
            Tab {
                title: root.is-vi ? "📋 Nhật ký & Console" : "📋 Logs & Console";
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: root.active-log-view == 0 ? (root.is-vi ? "📋 Xem Console hệ thống" : "📋 System Console") : (root.is-vi ? "🌐 Xem Nhật ký DNS" : "🌐 DNS Logs");
                            clicked => {
                                root.active-log-view = root.active-log-view == 0 ? 1 : 0;
                            }
                        }

                        if root.active-log-view == 0 : Button {
                            text: root.log-view-mode == 1 ? (root.is-vi ? "🌐 Xem Dòng Thời Gian" : "🌐 Timeline View") : (root.is-vi ? "📊 Gom Nhóm Tên Miền" : "📊 Group by Domain");
                            clicked => {
                                root.log-view-mode = root.log-view-mode == 1 ? 0 : 1;
                            }
                        }

                        filter-domain := LineEdit {
                            placeholder-text: root.is-vi ? "Lọc domain..." : "Filter domain...";
                            width: 180px;
                        }
                        filter-ip := LineEdit {
                            placeholder-text: root.is-vi ? "Lọc IP..." : "Filter IP...";
                            width: 130px;
                        }
                        Button {
                            text: root.is-vi ? "🔍 Lọc" : "🔍 Filter";
                            clicked => {
                                root.filter-logs(filter-domain.text, filter-ip.text, -1);
                            }
                        }
                        Button {
                            text: root.is-vi ? "✖ Xóa lọc" : "✖ Clear";
                            clicked => {
                                filter-domain.text = "";
                                filter-ip.text = "";
                                root.filter-logs("", "", -1);
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Button {
                            text: root.is-vi ? "💾 Xuất CSV" : "💾 Export CSV";
                            clicked => { root.export-logs(); }
                        }
                        Button {
                            text: root.is-vi ? "🗑️ Xóa log" : "🗑️ Clear Logs";
                            clicked => {
                                if (root.active-log-view == 0) {
                                    root.clear-logs();
                                } else {
                                    root.clear-console-logs();
                                }
                            }
                        }
                    }

                    if root.active-log-view == 0 && root.log-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for glog in root.grouped-logs : Rectangle {
                            height: 36px;
                            background: glog.is-blocked ? #450a0a : #1e293b;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: glog.domain; font-size: 13px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #0284c7;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.total-queries + (root.is-vi ? " truy vấn" : " queries"); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                if glog.blocked-queries > 0 : Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #dc2626;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.blocked-queries + (root.is-vi ? " bị chặn" : " blocked"); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Text { text: (root.is-vi ? "Gần nhất: " : "Last: ") + glog.last-seen; font-size: 11px; color: #94a3b8; vertical-alignment: center; min-width: 100px; }
                                Text { text: "IP: " + glog.last-ip; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 95px; }
                            }
                        }
                    }

                    if root.active-log-view == 0 && root.log-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for log in root.logs : Rectangle {
                            height: 32px;
                            background: log.is-blocked ? #450a0a : #1e293b;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: log.timestamp; font-size: 12px; color: #94a3b8; vertical-alignment: center; min-width: 80px; }
                                Text {
                                    text: log.is-blocked ? (root.is-vi ? "[BỊ CHẶN]" : "[BLOCKED]") : (root.is-vi ? "[CHO PHÉP]" : "[ALLOWED]");
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    min-width: 85px;
                                    color: log.is-blocked ? #f87171 : #4ade80;
                                }
                                Text { text: log.domain; font-size: 13px; color: #f1f5f9; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: log.source-ip; font-size: 12px; color: #64748b; vertical-alignment: center; min-width: 100px; }
                            }
                        }
                    }

                    if root.active-log-view == 1 : ListView {
                        vertical-stretch: 1;
                        for clog in root.console-logs : Rectangle {
                            height: 30px;
                            background: #020617;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                Text { text: clog.time; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }
                                Text {
                                    text: "[" + clog.level + "]";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: clog.level == "ERROR" ? #ef4444 : (clog.level == "WARN" ? #f59e0b : #38bdf8);
                                    vertical-alignment: center;
                                    min-width: 65px;
                                }
                                Text { text: clog.message; font-size: 12px; color: #e2e8f0; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }

            // Tab 6: Settings & System
            Tab {
                title: root.is-vi ? "⚙️ Cài đặt & Hệ thống" : "⚙️ Settings & System";
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Language Settings
                    Rectangle {
                        background: #1e293b;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #334155;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: root.is-vi ? "🌐 Ngôn ngữ hiển thị / Display Language:" : "🌐 Display Language / Ngôn ngữ hiển thị:";
                                font-size: 14px;
                                font-weight: 700;
                                color: #38bdf8;
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                Button {
                                    text: root.is-vi ? "🇻🇳 Tiếng Việt (Đang chọn)" : "🇻🇳 Tiếng Việt";
                                    clicked => { root.change-language("vi"); }
                                }
                                Button {
                                    text: !root.is-vi ? "🇬🇧 English (Selected)" : "🇬🇧 English";
                                    clicked => { root.change-language("en"); }
                                }
                            }
                        }
                    }

                    // System & Behavior Settings
                    Rectangle {
                        background: #1e293b;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #334155;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: root.is-vi ? "⚙️ Vận hành hệ thống & Khay ứng dụng:" : "⚙️ System Behavior & Notifications:";
                                font-size: 14px;
                                font-weight: 700;
                                color: #e2e8f0;
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                Button {
                                    text: root.autostart-enabled ? (root.is-vi ? "✅ Tự khởi động cùng Windows: BẬT" : "✅ Autostart with Windows: ON") : (root.is-vi ? "❌ Tự khởi động cùng Windows: TẮT" : "❌ Autostart with Windows: OFF");
                                    clicked => { root.toggle-autostart(!root.autostart-enabled); }
                                }
                                Button {
                                    text: root.minimize-to-tray-enabled ? (root.is-vi ? "✅ Thu nhỏ xuống Khay khi đóng: BẬT" : "✅ Minimize to Tray on Close: ON") : (root.is-vi ? "❌ Thu nhỏ xuống Khay khi đóng: TẮT" : "❌ Minimize to Tray on Close: OFF");
                                    clicked => { root.toggle-minimize-to-tray(!root.minimize-to-tray-enabled); }
                                }
                                Button {
                                    text: root.enable-notifications ? (root.is-vi ? "🔔 Thông báo chặn quảng cáo: BẬT" : "🔔 Ad Block Notifications: ON") : (root.is-vi ? "🔕 Thông báo chặn quảng cáo: TẮT" : "🔕 Ad Block Notifications: OFF");
                                    clicked => { root.toggle-notifications(!root.enable-notifications); }
                                }
                            }
                        }
                    }

                    // Engine & Version Info
                    Rectangle {
                        background: #1e293b;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #334155;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            Text {
                                text: root.is-vi ? "ℹ️ Thông tin phiên bản & Giấy phép:" : "ℹ️ Software Version & Information:";
                                font-size: 14px;
                                font-weight: 700;
                                color: #e2e8f0;
                            }

                            HorizontalLayout {
                                spacing: 20px;
                                Text {
                                    text: "Shield Ghita v" + root.app-version + " (Official Release)";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                                Text {
                                    text: "Engine: Rust + Slint UI + Win32 WFP";
                                    font-size: 12px;
                                    color: #94a3b8;
                                }
                                Text {
                                    text: root.last-update-text;
                                    font-size: 12px;
                                    color: #22c55e;
                                }
                            }

                            Text {
                                text: root.is-vi ? "Bảo mật mạng, chặn quảng cáo đa nền tảng (YouTube, Spotify, Web) & Giám sát lưu lượng máy tính thời gian thực." : "High-performance Windows network controller, system-wide adblocker, and real-time LAN inspector.";
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}

