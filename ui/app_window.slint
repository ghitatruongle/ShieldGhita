    OnboardingOverlay {
        x: 0; y: 0; width: 100%; height: 100%;
        dismiss-onboarding() => { root.dismiss-onboarding(); }
        enable-max-shield() => { root.enable-max-shield(); }
        overlay-fade: root.overlay-fade;
        show-onboarding <=> root.show-onboarding;
    }

    ToastPane {
        x: 0; y: 0; width: 100%; height: 100%;
        dismiss-toast() => { root.dismiss-toast(); }
        show-toast <=> root.show-toast;
        toast-domain <=> root.toast-domain;
        toast-is-threat <=> root.toast-is-threat;
        toast-slide: root.toast-slide;
        toast-time <=> root.toast-time;
        toast-title <=> root.toast-title;
    }

    UpdateBanner {
        x: 0; y: 0; width: 100%; height: 100%;
        dismiss-update-banner() => { root.dismiss-update-banner(); }
        open-update-release() => { root.open-update-release(); }
        update-available <=> root.update-available;
        update-version <=> root.update-version;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

    HeaderBar {
        app-version <=> root.app-version;
        cpu-usage <=> root.cpu-usage;
        is-admin-edition <=> root.is-admin-edition;
        live-traffic-rate <=> root.live-traffic-rate;
        mem-usage <=> root.mem-usage;
        open-latest-release() => { root.open-latest-release(); }
        protection-enabled <=> root.protection-enabled;
        security-score <=> root.security-score;
        security-score-hint <=> root.security-score-hint;
        status-text <=> root.status-text;
    }

    TabBar {
        active-tab <=> root.active-tab;
        is-admin-edition: root.is-admin-edition;
    }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-chrome;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.bg-card;
            clip: true;
        TabPane {
            index: 0;
            active-tab <=> root.active-tab;
            OverviewTab {
                    absorbed-count <=> root.absorbed-count;
                    active-rules-count <=> root.active-rules-count;
                    attack-detection-enabled <=> root.attack-detection-enabled;
                    blocked-count <=> root.blocked-count;
                    blocked-today <=> root.blocked-today;
                    blocked-week <=> root.blocked-week;
                    host-lan-ip <=> root.host-lan-ip;
                    lan-devices-count <=> root.lan-devices-count;
                    master-locked <=> root.master-locked;
                    lock-degraded <=> root.lock-degraded;
                    network-wide-adblock <=> root.network-wide-adblock;
                    protection-enabled <=> root.protection-enabled;
                    threats-blocked-count <=> root.threats-blocked-count;
                    toggle-attack-detection(v) => { root.toggle-attack-detection(v); }
                    toggle-master-lock(v) => { root.toggle-master-lock(v); }
                    toggle-network-wide-adblock(v) => { root.toggle-network-wide-adblock(v); }
                    toggle-protection(v) => { root.toggle-protection(v); }
                    total-queries <=> root.total-queries;
                    update-blocklist() => { root.update-blocklist(); }
            }
        }

        TabPane {
            index: 1;
            active-tab <=> root.active-tab;
            SecurityTab {
                    arp-spoof-detection <=> root.arp-spoof-detection;
                    attack-detection-enabled <=> root.attack-detection-enabled;
                    auto-block-attacks <=> root.auto-block-attacks;
                    clear-security-incidents() => { root.clear-security-incidents(); }
                    devices <=> root.devices;
                    export-incidents() => { root.export-incidents(); }
                    filter-logs-by-ip(v) => { root.filter-logs-by-ip(v); }
                    incident-search <=> root.incident-search;
                    is-scanning <=> root.is-scanning;
                    lan-subview-mode <=> root.lan-subview-mode;
                    quarantine-target <=> root.quarantine-target;
                    refresh-devices() => { root.refresh-devices(); }
                    security-incidents <=> root.security-incidents;
                    toggle-device-quarantine(v, a) => { root.toggle-device-quarantine(v, a); }
            }
        }

        TabPane {
            index: 2;
            active-tab <=> root.active-tab;
            MonitorTab {
                    clear-console-logs() => { root.clear-console-logs(); }
                    clear-logs() => { root.clear-logs(); }
                    conn-view-mode <=> root.conn-view-mode;
                    connections <=> root.connections;
                    console-logs <=> root.console-logs;
                    export-logs() => { root.export-logs(); }
                    filter-domain-text <=> root.filter-domain-text;
                    filter-ip-text <=> root.filter-ip-text;
                    filter-logs(v, a, b) => { root.filter-logs(v, a, b); }
                    grouped-connections <=> root.grouped-connections;
                    grouped-logs <=> root.grouped-logs;
                    log-view-mode <=> root.log-view-mode;
                    logs <=> root.logs;
                    monitor-subview-mode <=> root.monitor-subview-mode;
                    refresh-connections() => { root.refresh-connections(); }
            }
        }

        TabPane {
            index: 3;
