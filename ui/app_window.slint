    component TabPane inherits Rectangle {
        in property <int> index;
        in-out property <int> active-tab;
        in property <bool> extra-visible: true;
        x: 0; y: 0; width: 100%; height: 100%;
        visible: root.active-tab == root.index && root.extra-visible;
        opacity: root.active-tab == root.index ? 1.0 : 0.0;
        animate opacity { duration: 120ms; }
        @children
    }

export component AppWindow inherits Window {
    title: "Shield Ghita v" + root.app-version + I18n.t(" - Trình Điều Khiển Mạng & Bảo Mật Tối Cao", " - Master Network & Security Controller", " - 网络与安全总控");
    preferred-width: 1160px;
    preferred-height: 800px;
    min-width: 980px;
    min-height: 640px;
    background: Theme.bg-base;
    default-font-family: I18n.lang == 2 ? "Microsoft YaHei UI" : "Segoe UI";

    in-out property <string> app-version: "";
    in-out property <string> initial-panel-password: "";
    private property <string> quarantine-target: "";
    in-out property <bool> enable-notifications: true;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-domain: "";
    in-out property <string> toast-time: "";
    in-out property <string> toast-title: "";
    in-out property <bool> toast-is-threat: false;
    // Track 1 (0.1.5-alpha2): auto-update banner — set by the update watcher,
    // dismissed in-app; the banner is i18n-rendered Slint-side via I18n.t4.
    in-out property <bool> update-available: false;
    in-out property <string> update-version: "";
    callback open-update-release();
    callback dismiss-update-banner();

    in-out property <string> status-text: I18n.t4("🟢 Đang bảo vệ tối cao", "🟢 Maximum shield active", "🟢 最高防护运行中", "🟢 Максимальная защита активна");
    in-out property <int> blocked-count: 0;
    in-out property <int> blocked-today: 0;
    in-out property <int> blocked-week: 0;
    in-out property <int> total-queries: 0;
    in-out property <int> absorbed-count: 0;
    in-out property <int> active-rules-count: 0;
    in-out property <int> lan-devices-count: 0;
    in-out property <bool> is-scanning: false;
    in-out property <bool> is-scanning-cameras: false;
    in-out property <int> threats-blocked-count: 0;
    in-out property <int> security-score: 100;
    in-out property <string> security-score-hint: "";
    in-out property <string> host-lan-ip: "127.0.0.1";
    in-out property <bool> show-onboarding: false;
    in-out property <string> incident-search: "";
    callback dismiss-onboarding();
    callback enable-max-shield();

    // Track 5: giá trị 0→1 được animate khi toast/overlay/modal bật — các phần tử con
    // tham chiếu để trượt/mờ dần vào. Đặt ở Window (tồn tại vĩnh viễn) vì animate trên
    // phần tử tạo bởi `if` không chạy được ở khung hình khởi tạo.
    property <float> toast-slide: root.show-toast ? 1.0 : 0.0;
    animate toast-slide { duration: 200ms; }
    property <float> overlay-fade: root.show-onboarding ? 1.0 : 0.0;
    animate overlay-fade { duration: 120ms; }
    property <float> attack-modal-fade: root.attack-modal-open ? 1.0 : 0.0;
    animate attack-modal-fade { duration: 120ms; }

    in-out property <float> cpu-usage: 0.0;
    in-out property <float> mem-usage: 0.0;
    in-out property <bool> protection-enabled: true;
