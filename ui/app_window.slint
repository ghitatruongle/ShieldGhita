import { Button, LineEdit, ListView } from "std-widgets.slint";
import {
    I18n, NetworkDevice, ActiveConnection, AppConnectionGroup, LogEntry,
    DomainLogGroup, ConsoleLogEntry, SecurityIncident, ProximityDeviceItem,
    AttackHistoryItem, CameraItem, BehaviorProfileItem, DnsBenchmarkItem,
} from "common.slint";
import { TabButton, StatCard } from "widgets.slint";

export { I18n }
export { NetworkDevice, ActiveConnection, AppConnectionGroup, LogEntry }
export { DomainLogGroup, ConsoleLogEntry, SecurityIncident, ProximityDeviceItem }
export { AttackHistoryItem, CameraItem, BehaviorProfileItem, DnsBenchmarkItem }

// One row of the LAN device list (Security tab, subview 0).
component LanDeviceRow inherits Rectangle {
    in property <NetworkDevice> device;
    callback view-logs(string);
    callback toggle-quarantine(string, bool);

    height: 68px;
    background: device.is-quarantined ? #3b0712 : #111827;
    border-radius: 8px;
    border-width: 1px;
    border-color: device.is-quarantined ? #f43f5e : (device.threats-detected > 0 ? #ef4444 : #1f2937);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            min-width: 250px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: device.name; font-size: 13px; font-weight: 700; color: #f1f5f9; overflow: elide; }
                if device.is-quarantined : Rectangle {
                    height: 16px;
                    border-radius: 8px;
                    background: #e11d48;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text { text: I18n.t("⛔ CÔ LẬP", "⛔ ISOLATED", "⛔ 已隔离"); font-size: 9px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                    }
                }
            }
            Text { text: (I18n.t("Hãng: ", "Vendor: ", "厂商: ")) + device.vendor + (device.os-name != "" ? (" • " + device.os-name) : ""); font-size: 11px; color: #38bdf8; overflow: elide; }
            Text { text: (I18n.t("Độ tin cậy: ", "Confidence: ", "识别置信度: ")) + device.confidence + "%"; font-size: 10px; color: #64748b; }
        }

        VerticalLayout {
            alignment: center;
            min-width: 150px;
            Text { text: "IP: " + device.ip; font-size: 12px; font-weight: 700; color: #cbd5e1; }
            Text { text: "MAC: " + device.mac; font-size: 11px; color: #64748b; }
        }

        VerticalLayout {
            alignment: center;
            min-width: 160px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: #0284c7;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text { text: device.total-queries + " req"; font-size: 10px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: #dc2626;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text { text: device.blocked-queries + " ad"; font-size: 10px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                    }
                }
            }
            Text { text: (I18n.t("Domain: ", "Domain: ", "域名: ")) + device.last-domain; font-size: 11px; color: #94a3b8; overflow: elide; }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            min-width: 130px;
            Text {
                text: device.is-online ? (I18n.t("🟢 TRỰC TUYẾN", "🟢 ONLINE", "🟢 在线")) : (I18n.t("🔴 NGOẠI TUYẾN", "🔴 OFFLINE", "🔴 离线"));
                font-size: 11px;
                font-weight: 800;
                color: device.is-online ? #4ade80 : #f87171;
            }
            Text { text: device.risk-level != "" ? device.risk-level : (I18n.t("Độ trễ: ", "Latency: ", "延迟: ") + device.latency); font-size: 11px; color: #94a3b8; }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            Button {
                text: I18n.t("📋 Log", "📋 Log", "📋 日志");
                clicked => { root.view-logs(device.ip); }
            }
            if !device.is-local : Button {
                text: device.is-quarantined ? I18n.t("🟢 Mở", "🟢 Free", "🟢 解除") : I18n.t("⛔ Cách ly", "⛔ Isolate", "⛔ 隔离");
                clicked => { root.toggle-quarantine(device.ip, !device.is-quarantined); }
            }
        }
    }
}

// Row of the DNS Benchmark list
component DnsBenchmarkRow inherits Rectangle {
    in property <DnsBenchmarkItem> item;

    height: 48px;
    background: item.is-fastest ? #062e24 : #111827;
    border-radius: 8px;
    border-width: 1px;
    border-color: item.is-fastest ? #10b981 : #1f2937;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            min-width: 240px;
            Text { text: item.provider-name; font-size: 13px; font-weight: 700; color: #f1f5f9; }
            Text { text: "IP: " + item.ip; font-size: 11px; color: #94a3b8; }
        }

        Rectangle { horizontal-stretch: 1; }

        if item.is-fastest : Rectangle {
            height: 22px;
            border-radius: 11px;
            background: #059669;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                Text { text: I18n.t("⚡ NHANH NHẤT", "⚡ FASTEST", "⚡ 最快"); font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
            }
        }

        VerticalLayout {
            alignment: center;
            min-width: 100px;
            Text {
                text: item.status;
                font-size: 13px;
                font-weight: 800;
                color: item.is-fastest ? #34d399 : (item.response-ms < 100 ? #38bdf8 : #f59e0b);
                horizontal-alignment: right;
            }
        }
    }
}

// One incident card of the security feed (Security tab, subview 1).
component IncidentRow inherits Rectangle {
    in property <SecurityIncident> inc;

    height: 74px;
    background: inc.severity == "CRITICAL" ? #2a0808 : (inc.severity == "HIGH" ? #241405 : #0f172a);
    border-radius: 8px;
    border-width: 1px;
    border-color: inc.severity == "CRITICAL" ? #ef4444 : (inc.severity == "HIGH" ? #f59e0b : #3b82f6);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 14px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            min-width: 85px;
            spacing: 4px;
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: inc.severity == "CRITICAL" ? #dc2626 : (inc.severity == "HIGH" ? #d97706 : #2563eb);
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: I18n.sev(inc.severity);
                        font-size: 10px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }
            Text { text: inc.time; font-size: 11px; color: #94a3b8; horizontal-alignment: center; }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "🚨 " + inc.incident-type;
                    font-size: 13px;
                    font-weight: 800;
                    color: inc.severity == "CRITICAL" ? #fca5a5 : (inc.severity == "HIGH" ? #fcd34d : #93c5fd);
                }
                Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: #1e293b;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text { text: "IP: " + inc.source-ip; font-size: 10px; font-weight: 700; color: #cbd5e1; vertical-alignment: center; }
                    }
                }
            }
            Text { text: inc.details; font-size: 11px; color: #e2e8f0; overflow: elide; }
        }

        VerticalLayout {
            alignment: center;
            min-width: 250px;
            Rectangle {
                border-radius: 6px;
                background: #064e3b;
                border-width: 1px;
                border-color: #059669;
                VerticalLayout {
                    padding: 6px;
                    Text {
                        text: (I18n.t("🛡️ Biện pháp IPS: ", "🛡️ IPS Action: ", "🛡️ IPS 处置: ")) + inc.mitigation;
                        font-size: 11px;
                        font-weight: 700;
                        color: #6ee7b7;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Shield Ghita v" + root.app-version + I18n.t(" - Trình Điều Khiển Mạng & Bảo Mật Tối Cao", " - Master Network & Security Controller", " - 网络与安全总控");
    preferred-width: 1160px;
    preferred-height: 800px;
    min-width: 980px;
    min-height: 640px;
    background: #0b0f19;
    default-font-family: I18n.lang == 2 ? "Microsoft YaHei UI" : "Segoe UI";

    in-out property <string> app-version: "";
    in-out property <bool> enable-notifications: true;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-domain: "";
    in-out property <string> toast-time: "";
    in-out property <string> toast-title: "";
    in-out property <bool> toast-is-threat: false;

    in-out property <string> status-text: "🟢 Đang bảo vệ tối cao";
    in-out property <int> blocked-count: 0;
    in-out property <int> blocked-today: 0;
    in-out property <int> blocked-week: 0;
    in-out property <int> total-queries: 0;
    in-out property <int> absorbed-count: 0;
    in-out property <int> active-rules-count: 0;
    in-out property <int> lan-devices-count: 0;
    in-out property <bool> is-scanning: false;
    in-out property <int> threats-blocked-count: 0;
    in-out property <int> security-score: 100;
    in-out property <string> host-lan-ip: "127.0.0.1";

    in-out property <float> cpu-usage: 0.0;
    in-out property <float> mem-usage: 0.0;
    in-out property <bool> protection-enabled: true;
    in-out property <bool> master-locked: false;
    in-out property <bool> silent-sinkhole: true;
    in-out property <bool> network-wide-adblock: false;
    in-out property <bool> attack-detection-enabled: false;
    in-out property <bool> auto-block-attacks: false;
    in-out property <bool> arp-spoof-detection: false;

    in-out property <bool> autostart-enabled: true;
    in-out property <bool> minimize-to-tray-enabled: true;
    in-out property <string> last-update-text: "Chưa cập nhật";
    in-out property <string> live-traffic-rate: "0 KB/s";
    in-out property <bool> minimize-to-tray-on-minimize: true;
    in-out property <bool> start-hidden-in-tray: false;

    in-out property <[NetworkDevice]> devices;
    in-out property <[ActiveConnection]> connections;
    in-out property <[AppConnectionGroup]> grouped-connections;
    in-out property <[LogEntry]> logs;
    in-out property <[DomainLogGroup]> grouped-logs;
    in-out property <[ConsoleLogEntry]> console-logs;
    in-out property <[SecurityIncident]> security-incidents;
    in-out property <[string]> custom-rules;
    in-out property <[string]> allowed-rules;
    in-out property <int> active-log-view: 0;
    in-out property <int> conn-view-mode: 1;
    in-out property <int> log-view-mode: 0;
    in-out property <int> lan-subview-mode: 0;
    in-out property <int> monitor-subview-mode: 0;
    in-out property <string> filter-domain-text: "";
    in-out property <string> filter-ip-text: "";

    in-out property <int> active-tab: 0;
    in-out property <bool> is-admin-edition: false;
    in-out property <[ProximityDeviceItem]> proximity-devices;
    in-out property <[BehaviorProfileItem]> behavior-profiles;
    in-out property <int> admin-subview-mode: 0;
    in-out property <int> proximity-devices-count: 0;
    in-out property <int> behavior-profiles-count: 0;
    in-out property <int> high-risk-count: 0;
    in-out property <int> wifi-nodes-count: 0;

    in-out property <bool> attack-modal-open: false;
    in-out property <int> attack-modal-tab: 2;
    in-out property <string> attack-target-ip: "";
    in-out property <string> attack-target-name: "";
    in-out property <string> attack-target-mac: "";
    in-out property <string> attack-target-vendor: "";
    in-out property <int> attack-mode: 1;
    in-out property <int> attack-duration-min: 15;
    in-out property <string> attack-message: "";
    in-out property <[AttackHistoryItem]> attack-history;
    in-out property <int> active-attacks-count: 0;
    in-out property <[CameraItem]> camera-list;

    in-out property <bool> camera-live-modal-open: false;
    in-out property <image> camera-live-frame;
    in-out property <string> camera-live-title: "";
    in-out property <string> camera-live-ip: "";
    in-out property <string> camera-live-vendor: "";
    in-out property <string> camera-live-rtsp: "";
    in-out property <string> camera-live-status: "";
    in-out property <string> camera-live-user: "admin";
    in-out property <string> camera-live-pass: "";
    in-out property <bool> camera-live-is-playing: false;
    in-out property <bool> camera-live-has-frame: false;
    in-out property <string> camera-security-status: "";
    in-out property <string> camera-save-user: "";
    in-out property <string> camera-save-pass: "";
    in-out property <bool> camera-security-is-vulnerable: false;

    in-out property <[DnsBenchmarkItem]> dns-benchmarks;
    in-out property <bool> is-running-benchmark: false;
    in-out property <float> net-down-mbps: 0;
    in-out property <float> net-up-mbps: 0;
    in-out property <string> net-if-name: "";
    in-out property <float> speed-download: -1;
    in-out property <float> speed-upload: -1;
    in-out property <int> speed-ping-ms: -1;
    in-out property <string> speed-detail: "";
    in-out property <bool> is-running-speed: false;
    in-out property <string> benchmark-domain-input: "google.com";
    in-out property <int> active-diag-view: 0;

    callback toggle-protection(bool);
    callback toggle-master-lock(bool);
    callback toggle-silent-sinkhole(bool);
    callback toggle-network-wide-adblock(bool);
    callback toggle-attack-detection(bool);
    callback toggle-auto-block-attacks(bool);
    callback toggle-arp-spoof-detection(bool);
    callback toggle-autostart(bool);
    callback toggle-minimize-to-tray(bool);
    callback toggle-notifications(bool);
    callback change-language(string);
    callback refresh-devices();
    callback refresh-connections();
    callback clear-logs();
    callback clear-console-logs();
    callback clear-security-incidents();
    callback add-custom-rule(string);
    callback remove-custom-rule(string);
    callback add-allowed-rule(string);
    callback remove-allowed-rule(string);
    callback update-blocklist();
    callback export-logs();
    callback export-incidents();
    callback filter-logs(string, string, int);
    callback filter-logs-by-ip(string);
    callback dismiss-toast();
    callback refresh-upstream-speed();
    callback check-update();
    callback open-latest-release();
    callback trigger-proximity-scan();
    callback refresh-admin-data();
    callback launch-attack(string, string, string, int, int);
    callback cancel-attack(string);
    callback scan-cameras();
    callback open-camera-stream(string);
    callback copy-camera-url(string);
    callback start-camera-live-stream(string, string, string);
    callback stop-camera-live-stream();
    callback audit-camera-security(string);
    callback save-camera-credential(string, string, string);
    callback save-camera-snapshot(string);
    callback send-camera-ptz(string);
    callback toggle-minimize-to-tray-on-minimize(bool);
    callback toggle-start-hidden-in-tray(bool);
    callback run-speed-test();
    callback run-dns-benchmark(string);
    callback toggle-device-quarantine(string, bool);
    callback export-config-backup();
    callback import-config-backup();

    if root.show-toast : Rectangle {
        z: 100;
        x: root.width - 410px;
        y: 60px;
        width: 390px;
        height: 72px;
        background: root.toast-is-threat ? #450a0a : #1e1b4b;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.toast-is-threat ? #ef4444 : #818cf8;
        drop-shadow-color: #000000aa;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 8px;
        drop-shadow-blur: 20px;

        HorizontalLayout {
            padding: 10px;
            spacing: 12px;
            alignment: center;

            Text {
                text: root.toast-is-threat ? "🚨" : "🛡️";
                font-size: 26px;
                vertical-alignment: center;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.toast-title != "" ? root.toast-title : (I18n.t("ĐÃ CHẶN QUẢNG CÁO & THEO DÕI", "AD & TRACKER BLOCKED", "已拦截广告和跟踪器"));
                    font-size: 11px;
                    font-weight: 800;
                    color: root.toast-is-threat ? #fca5a5 : #a5b4fc;
                }
                Text {
                    text: root.toast-domain + " (" + root.toast-time + ")";
                    font-size: 12px;
                    font-weight: 700;
                    color: #ffffff;
                    overflow: elide;
                }
            }

            Button {
                text: "✖";
                width: 32px;
                clicked => { root.dismiss-toast(); }
            }
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 16px;
            alignment: center;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Image {
                    source: @image-url("assets/logo.png");
                    width: 32px;
                    height: 32px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Shield Ghita";
                            font-size: 20px;
                            font-weight: 800;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 18px;
                            border-radius: 9px;
                            background: #0284c7;
                            version-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-latest-release(); }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: "v" + root.app-version;
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.is-admin-edition : Rectangle {
                            height: 18px;
                            border-radius: 9px;
                            background: #7c3aed;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: I18n.t("👑 BẢN QUẢN TRỊ", "👑 ADMIN EDITION", "👑 管理员版");
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: I18n.t("Bảo mật mạng, Ngăn chặn xâm nhập & Chặn quảng cáo LAN", "Cyber Security, IDS/IPS & LAN Adblock Controller", "网络安全、入侵防御与局域网广告拦截");
                        font-size: 11px;
                        color: #94a3b8;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: root.protection-enabled ? #064e3b : #450a0a;
                    border-width: 1px;
                    border-color: root.protection-enabled ? #059669 : #dc2626;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: root.status-text;
                            font-size: 12px;
                            font-weight: 800;
                            color: root.protection-enabled ? #6ee7b7 : #fca5a5;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #1e1b4b;
                    border-width: 1px;
                    border-color: #4f46e5;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: (I18n.t("🛡 Điểm an ninh: ", "🛡 Security Score: ", "🛡 安全评分: ")) + root.security-score + "/100";
                            font-size: 12px;
                            font-weight: 800;
                            color: #a5b4fc;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #0f172a;
                    border-width: 1px;
                    border-color: #334155;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "CPU: " + Math.round(root.cpu-usage) + "%";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "RAM: " + Math.round(root.mem-usage * 10.0) / 10.0 + " GB";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "⚡ " + root.live-traffic-rate;
                            font-size: 11px;
                            font-weight: 800;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 38px;

            TabButton {
                text: I18n.t("📊 Tổng quan", "📊 Overview", "📊 总览");
                active: root.active-tab == 0;
                active-color: #38bdf8;
                clicked => { root.active-tab = 0; }
            }

            TabButton {
                text: I18n.t("🛡 An ninh", "🛡 Security", "🛡 安全");
                active: root.active-tab == 1;
                active-color: #34d399;
                clicked => { root.active-tab = 1; }
            }

            TabButton {
                text: I18n.t("🚀 Giám sát", "🚀 Monitor & Logs", "🚀 监控与日志");
                active: root.active-tab == 2;
                active-color: #a78bfa;
                clicked => { root.active-tab = 2; }
            }

            TabButton {
                text: I18n.t("🚫 Bộ lọc", "🚫 Filter Rules", "🚫 过滤规则");
                active: root.active-tab == 3;
                active-color: #f87171;
                clicked => { root.active-tab = 3; }
            }

            TabButton {
                text: I18n.t("⚙ Cài đặt", "⚙ Settings", "⚙ 设置");
                active: root.active-tab == 4;
                active-color: #38bdf8;
                clicked => { root.active-tab = 4; }
            }

            TabButton {
                text: I18n.t("🩺 Chẩn đoán", "🩺 Diagnostics", "🩺 网络诊断");
                active: root.active-tab == 6;
                active-color: #38bdf8;
                clicked => { root.active-tab = 6; }
            }

            if root.is-admin-edition : TabButton {
                text: I18n.t("👑 Quản trị Admin", "👑 Admin Suite", "👑 管理员套件");
                active: root.active-tab == 5;
                active-color: #c084fc;
                clicked => { root.active-tab = 5; }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #0d121f;
            border-radius: 10px;
            border-width: 1px;
            border-color: #1e293b;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.active-tab == 0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 14px;

                        StatCard {
                            horizontal-stretch: 1;
                            card-title: I18n.t("TỔNG TRUY VẤN DNS", "TOTAL DNS QUERIES", "DNS 查询总数");
                            big-value: root.total-queries;
                            accent: #38bdf8;
                            sub1: I18n.t("Xử lý song song siêu tốc qua DoH", "Ultra-fast parallel DoH engine", "DoH 超高速并行处理引擎");
                        }

                        StatCard {
                            horizontal-stretch: 1;
                            card-title: I18n.t("QUẢNG CÁO & THEO DÕI ĐÃ CHẶN", "ADS & TRACKERS BLOCKED", "已拦截广告和跟踪器");
                            big-value: root.blocked-count;
                            accent: #22c55e;
                            sub1: (I18n.t("Hôm nay: ", "Today: ", "今日: ")) + root.blocked-today + (I18n.t(" • Tuần này: ", " • This week: ", " • 本周: ")) + root.blocked-week;
                            sub1-color: #86efac;
                            sub2: (I18n.t("Đã lọc ngầm bởi Silent Sinkhole: ", "Silently absorbed: ", "静默黑洞已吸收: ")) + root.absorbed-count;
                            sub2-color: #4ade80;
                        }

                        StatCard {
                            horizontal-stretch: 1;
                            card-title: I18n.t("MỐI NGUY & TẤN CÔNG ĐÃ CHẶN", "THREATS & ATTACKS BLOCKED", "已拦截威胁和攻击");
                            big-value: root.threats-blocked-count;
                            accent: #f87171;
                            sub1: I18n.t("IDS/IPS & Chống rò rỉ DNS Tunneling", "IDS/IPS & Anti-DNS Tunneling", "IDS/IPS 与 DNS 隧道防护");
                            sub1-color: #fca5a5;
                        }

                        StatCard {
                            horizontal-stretch: 1;
                            card-title: I18n.t("THIẾT BỊ MẠNG LAN HOẠT ĐỘNG", "ACTIVE LAN DEVICES", "活跃局域网设备");
                            big-value: root.lan-devices-count;
                            accent: #a78bfa;
                            sub1: (I18n.t("Quy tắc lọc đang kích hoạt: ", "Active filter rules: ", "生效中的过滤规则: ")) + root.active-rules-count;
                            sub1-color: #cbd5e1;
                        }
                    }

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 14px;
                            Text { text: I18n.t("⚡ Trung tâm điều khiển mạng tối cao (Master Controller Quick Actions):", "⚡ Master Internet Controller Quick Actions:", "⚡ 网络总控中心 (快速操作):"); font-size: 14px; font-weight: 700; color: #e2e8f0; }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    text: root.protection-enabled ? (I18n.t("⏸️ Tạm dừng bảo vệ máy", "⏸️ Pause Protection", "⏸️ 暂停防护")) : (I18n.t("▶️ Bật bảo vệ máy", "▶️ Enable Protection", "▶️ 启用防护"));
                                    clicked => { root.toggle-protection(!root.protection-enabled); }
                                }
                                Button {
                                    text: root.master-locked ? (I18n.t("🔓 Mở khóa Internet", "🔓 Unlock Internet", "🔓 解锁互联网")) : (I18n.t("🔒 Khóa toàn bộ Internet (Kill Switch)", "🔒 Master Internet Lock (Kill Switch)", "🔒 一键断网 (Kill Switch)"));
                                    clicked => { root.toggle-master-lock(!root.master-locked); }
                                }
                                Button {
                                    text: root.network-wide-adblock ? (I18n.t("🌐 Chống QC toàn mạng: BẬT", "🌐 Network Adblock: ON", "🌐 全网广告拦截: 开")) : (I18n.t("🌐 Chống QC toàn mạng: TẮT", "🌐 Network Adblock: OFF", "🌐 全网广告拦截: 关"));
                                    clicked => { root.toggle-network-wide-adblock(!root.network-wide-adblock); }
                                }
                                Button {
                                    text: root.attack-detection-enabled ? (I18n.t("🛡️ Chống tấn công: BẬT", "🛡️ IDS/IPS Attack Shield: ON", "🛡️ 入侵防御: 开")) : (I18n.t("🛡️ Chống tấn công: TẮT", "🛡️ IDS/IPS Attack Shield: OFF", "🛡️ 入侵防御: 关"));
                                    clicked => { root.toggle-attack-detection(!root.attack-detection-enabled); }
                                }
                                Button {
                                    text: I18n.t("🔄 Cập nhật Bộ lọc", "🔄 Update Blocklists", "🔄 更新过滤库");
                                    clicked => { root.update-blocklist(); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: I18n.t("📡 Hướng dẫn cấu hình Chống quảng cáo Toàn mạng LAN:", "📡 Quick LAN Setup Guide:", "📡 局域网全网去广告快速设置指南:"); font-size: 14px; font-weight: 700; color: #38bdf8; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: (I18n.t("Địa chỉ IP máy tính này: ", "Host Machine IP: ", "本机 IP 地址: ")) + root.host-lan-ip; font-size: 13px; font-weight: 800; color: #22c55e; }
                            }
                            Text {
                                text: I18n.t(
                                    "• Bật tính năng 'Chống quảng cáo toàn mạng' ở trên hoặc trong Cài đặt.\n• Đặt DNS trên Router Wi-Fi hoặc trên Điện thoại (iPhone/Android)/Smart TV thành: ",
                                    "• Enable 'Network-wide Ad Blocking' above or in Settings.\n• Set DNS on your Wi-Fi Router or Phone/Smart TV to: ",
                                    "• 在上方或“设置”中启用“全网广告拦截”。\n• 将 Wi-Fi 路由器或手机/智能电视的 DNS 设置为：",
                                ) + root.host-lan-ip + I18n.t(
                                    "\n• Mọi thiết bị kết nối vào Wi-Fi sẽ tự động sạch 100% quảng cáo và được bảo vệ như máy tính này.",
                                    "\n• All connected LAN devices will have ads blocked automatically without extra software.",
                                    "\n• 所有接入 Wi-Fi 的设备都将自动屏蔽广告，并获得与本机相同的防护。",
                                );
                                font-size: 12px;
                                color: #94a3b8;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.active-tab == 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: I18n.t("🛡️ HỆ THỐNG PHÁT HIỆN TẤN CÔNG (IDS)", "🛡️ INTRUSION DETECTION (IDS)", "🛡️ 入侵检测系统 (IDS)"); font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: root.attack-detection-enabled ? (I18n.t("🟢 ĐANG BẢO VỆ", "🟢 ACTIVE", "🟢 防护中")) : (I18n.t("⚪ ĐANG TẮT", "⚪ DISABLED", "⚪ 已关闭")); font-size: 13px; font-weight: 800; color: root.attack-detection-enabled ? #4ade80 : #94a3b8; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: I18n.t("⚡ TỰ ĐỘNG KHÓA IP TẤN CÔNG (IPS)", "⚡ AUTO-BLOCK THREATS (IPS)", "⚡ 自动封锁攻击 IP (IPS)"); font-size: 11px; font-weight: 700; color: #f87171; }
                                Text { text: root.auto-block-attacks ? (I18n.t("🟢 TỰ ĐỘNG CÔ LẬP NGUỒN", "🟢 AUTO-MITIGATION ON", "🟢 自动隔离攻击源")) : (I18n.t("⚪ CHỈ CẢNH BÁO", "⚪ ALERT ONLY", "⚪ 仅告警")); font-size: 13px; font-weight: 800; color: root.auto-block-attacks ? #4ade80 : #94a3b8; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                Text { text: I18n.t("📡 GIÁM SÁT ARP SPOOFING / MITM", "📡 ARP SPOOFING WATCH", "📡 ARP 欺骗 / 中间人监控"); font-size: 11px; font-weight: 700; color: #fbbf24; }
                                Text { text: root.arp-spoof-detection ? (I18n.t("🟢 QUẢN TRỊ GATEWAY", "🟢 GATEWAY MONITORED", "🟢 网关监控中")) : (I18n.t("⚪ ĐANG TẮT", "⚪ DISABLED", "⚪ 已关闭")); font-size: 13px; font-weight: 800; color: root.arp-spoof-detection ? #4ade80 : #94a3b8; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.lan-subview-mode == 0 ? (I18n.t("● 🌐 Thiết bị LAN", "● 🌐 LAN Devices", "● 🌐 局域网设备")) : (I18n.t("🌐 Thiết bị LAN", "🌐 LAN Devices", "🌐 局域网设备"));
                            clicked => { root.lan-subview-mode = 0; }
                        }
                        Button {
                            text: root.lan-subview-mode == 1 ? (I18n.t("● 🚨 Cảnh báo An ninh", "● 🚨 Incidents", "● 🚨 安全警报")) : (I18n.t("🚨 Cảnh báo An ninh", "🚨 Incidents", "🚨 安全警报"));
                            clicked => { root.lan-subview-mode = 1; }
                        }
                        Button {
                            text: root.lan-subview-mode == 2 ? (I18n.t("● 🔓 Cổng mở LAN", "● 🔓 Open Ports", "● 🔓 局域网开放端口")) : (I18n.t("🔓 Cổng mở LAN", "🔓 Open Ports", "🔓 局域网开放端口"));
                            clicked => { root.lan-subview-mode = 2; }
                        }
                        if root.lan-subview-mode != 1 : Button {
                            text: I18n.t("🔍 Quét lại mạng LAN", "🔍 Rescan LAN Subnet", "🔍 重新扫描局域网");
                            clicked => { root.refresh-devices(); }
                        }
                        if root.lan-subview-mode == 1 : Button {
                            text: I18n.t("🗑️ Xóa toàn bộ cảnh báo", "🗑️ Clear All Incidents", "🗑️ 清空所有警报");
                            clicked => { root.clear-security-incidents(); }
                        }
                        if root.lan-subview-mode == 1 : Button {
                            text: I18n.t("💾 Xuất CSV", "💾 Export CSV", "💾 导出 CSV");
                            clicked => { root.export-incidents(); }
                        }
                        Text {
                            text: root.lan-subview-mode == 0 ? (I18n.t("Giám sát thời gian thực mọi hoạt động Internet của thiết bị LAN:", "Real-time Internet activity of LAN devices:", "实时监控局域网设备的所有上网活动:")) : (root.lan-subview-mode == 1 ? (I18n.t("Nhật ký cảnh báo an ninh & ngăn chặn xâm nhập thời gian thực:", "Real-time Security Incidents & Intrusion Prevention Logs:", "实时安全警报与入侵防御日志:")) : (I18n.t("Cổng dịch vụ đang mở trên từng thiết bị LAN & mức độ rủi ro:", "Open service ports per LAN device & risk level:", "各局域网设备开放的服务端口及风险等级:")));
                            font-size: 13px;
                            font-weight: 600;
                            color: #94a3b8;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    if root.is-scanning : Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: #1e1b4b;
                        border-width: 1px;
                        border-color: #4f46e5;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: start;
                            Text {
                                text: I18n.t("⏳ Đang quét mạng LAN & phân tích cổng mở…", "⏳ Scanning LAN & analyzing open ports…", "⏳ 正在扫描局域网并分析开放端口…");
                                font-size: 12px;
                                font-weight: 700;
                                color: #a5b4fc;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if !root.is-scanning && root.lan-subview-mode != 1 && root.devices.length == 0 : Text {
                        text: I18n.t("Chưa phát hiện thiết bị LAN nào — bấm 🔍 Quét lại mạng LAN.", "No LAN devices detected yet — press 🔍 Rescan LAN Subnet.", "尚未发现局域网设备 — 请点击 🔍 重新扫描局域网。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.lan-subview-mode == 1 && root.security-incidents.length == 0 : Text {
                        text: I18n.t("✅ Chưa có cảnh báo an ninh nào — hệ thống đang hoạt động an toàn.", "✅ No security incidents yet — system is running safe.", "✅ 暂无安全警报 — 系统运行安全。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.lan-subview-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for device in root.devices : LanDeviceRow {
                            device: device;
                            view-logs(ip) => { root.filter-logs-by-ip(ip); }
                            toggle-quarantine(ip, q) => { root.toggle-device-quarantine(ip, q); }
                        }
                    }

                    if root.lan-subview-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for inc in root.security-incidents : IncidentRow {
                            inc: inc;
                        }
                    }

                    if root.lan-subview-mode == 2 : ListView {
                        vertical-stretch: 1;
                        for device in root.devices : Rectangle {
                            height: 68px;
                            background: device.port-risk == "HIGH" ? #2a0808 : (device.port-risk == "MEDIUM" ? #241405 : #111827);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: device.port-risk == "HIGH" ? #ef4444 : (device.port-risk == "MEDIUM" ? #f59e0b : #1f2937);
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 230px;
                                    Text { text: device.name; font-size: 13px; font-weight: 700; color: #f1f5f9; overflow: elide; }
                                    Text { text: "IP: " + device.ip + "  •  MAC: " + device.mac; font-size: 11px; color: #64748b; overflow: elide; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: "🔓 " + device.open-ports; font-size: 12px; font-weight: 700; color: #e2e8f0; overflow: elide; }
                                    Text {
                                        text: device.port-advice != "" ? ((I18n.t("Khuyến nghị: ", "Advice: ", "建议: ")) + device.port-advice) : (I18n.t("Không phát hiện cổng rủi ro đang mở.", "No risky open ports detected.", "未发现存在风险的开放端口。"));
                                        font-size: 11px;
                                        color: #94a3b8;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    width: 130px;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: device.port-risk == "HIGH" ? #7f1d1d : (device.port-risk == "MEDIUM" ? #78350f : #064e3b);
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: device.port-risk == "HIGH" ? (I18n.t("🔴 RỦI RO CAO", "🔴 HIGH RISK", "🔴 高风险")) : (device.port-risk == "MEDIUM" ? (I18n.t("🟡 TRUNG BÌNH", "🟡 MEDIUM", "🟡 中风险")) : (I18n.t("🟢 AN TOÀN", "🟢 SAFE", "🟢 安全")));
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.active-tab == 2;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: root.monitor-subview-mode == 0 ? (I18n.t("● 🚀 Tiến trình mạng", "● 🚀 Active Connections", "● 🚀 网络连接")) : (I18n.t("🚀 Tiến trình mạng", "🚀 Active Connections", "🚀 网络连接"));
                            clicked => { root.monitor-subview-mode = 0; }
                        }
                        Button {
                            text: root.monitor-subview-mode == 1 ? (I18n.t("● 🌐 Nhật ký DNS", "● 🌐 DNS Logs", "● 🌐 DNS 日志")) : (I18n.t("🌐 Nhật ký DNS", "🌐 DNS Logs", "🌐 DNS 日志"));
                            clicked => { root.monitor-subview-mode = 1; }
                        }
                        Button {
                            text: root.monitor-subview-mode == 2 ? (I18n.t("● 📋 Console hệ thống", "● 📋 System Console", "● 📋 系统控制台")) : (I18n.t("📋 Console hệ thống", "📋 System Console", "📋 系统控制台"));
                            clicked => { root.monitor-subview-mode = 2; }
                        }

                        Rectangle { width: 1px; height: 20px; background: #334155; }

                        if root.monitor-subview-mode == 0 : Button {
                            text: I18n.t("🔄 Làm mới", "🔄 Refresh", "🔄 刷新");
                            clicked => { root.refresh-connections(); }
                        }
                        if root.monitor-subview-mode == 0 : Button {
                            text: root.conn-view-mode == 1 ? (I18n.t("📄 Xem Chi Tiết", "📄 Detailed List", "📄 详细列表")) : (I18n.t("🚀 Gom Nhóm Ứng Dụng", "🚀 Group by App", "🚀 按应用分组"));
                            clicked => { root.conn-view-mode = root.conn-view-mode == 1 ? 0 : 1; }
                        }

                        if root.monitor-subview-mode == 1 : Button {
                            text: root.log-view-mode == 1 ? (I18n.t("🌐 Dòng Thời Gian", "🌐 Timeline View", "🌐 时间线视图")) : (I18n.t("📊 Gom Nhóm Domain", "📊 Group by Domain", "📊 按域名分组"));
                            clicked => { root.log-view-mode = root.log-view-mode == 1 ? 0 : 1; }
                        }

                        if root.monitor-subview-mode == 1 : LineEdit {
                            placeholder-text: I18n.t("Lọc domain...", "Filter domain...", "筛选域名...");
                            width: 160px;
                            text <=> root.filter-domain-text;
                        }
                        if root.monitor-subview-mode == 1 : LineEdit {
                            placeholder-text: I18n.t("Lọc IP...", "Filter IP...", "筛选 IP...");
                            width: 120px;
                            text <=> root.filter-ip-text;
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("🔍 Lọc", "🔍 Filter", "🔍 筛选");
                            clicked => { root.filter-logs(root.filter-domain-text, root.filter-ip-text, -1); }
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("✖ Xóa lọc", "✖ Clear", "✖ 清除筛选");
                            clicked => {
                                root.filter-domain-text = "";
                                root.filter-ip-text = "";
                                root.filter-logs("", "", -1);
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("💾 Xuất CSV", "💾 Export CSV", "💾 导出 CSV");
                            clicked => { root.export-logs(); }
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("🗑️ Xóa log", "🗑️ Clear Logs", "🗑️ 清空日志");
                            clicked => { root.clear-logs(); }
                        }
                        if root.monitor-subview-mode == 2 : Button {
                            text: I18n.t("🗑️ Xóa console log", "🗑️ Clear Console", "🗑️ 清空控制台");
                            clicked => { root.clear-console-logs(); }
                        }
                    }

                    if root.monitor-subview-mode == 0 && root.connections.length == 0 && root.grouped-connections.length == 0 : Text {
                        text: I18n.t("Chưa có kết nối mạng nào đang hoạt động — bấm 🔄 Làm mới.", "No active network connections — press 🔄 Refresh.", "暂无活动的网络连接 — 请点击 🔄 刷新。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.monitor-subview-mode == 1 && root.logs.length == 0 : Text {
                        text: I18n.t("Chưa có nhật ký DNS — nhật ký sẽ hiện khi có truy vấn.", "No DNS logs yet — entries appear as queries arrive.", "暂无 DNS 日志 — 有查询时会自动显示。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.monitor-subview-mode == 0 && root.conn-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for grp in root.grouped-connections : Rectangle {
                            height: 42px;
                            background: #111827;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + grp.process-name; font-size: 13px; font-weight: 700; color: #38bdf8; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + grp.pid; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #0284c7;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: grp.connection-count + (I18n.t(" kết nối", " conns", " 个连接")); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Text { text: grp.protocol-summary; font-size: 11px; font-weight: 700; color: #a78bfa; vertical-alignment: center; min-width: 55px; }
                                Text { text: "➔ " + grp.destinations-summary; font-size: 12px; color: #cbd5e1; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: grp.state-summary; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 0 && root.conn-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for conn in root.connections : Rectangle {
                            height: 38px;
                            background: #111827;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + conn.process-name; font-size: 13px; font-weight: 700; color: #38bdf8; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + conn.pid; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }
                                Text { text: conn.protocol; font-size: 11px; font-weight: 700; color: #a78bfa; vertical-alignment: center; min-width: 45px; }
                                Text { text: conn.local-addr; font-size: 12px; color: #94a3b8; vertical-alignment: center; min-width: 150px; }
                                Text { text: "➔"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                                Text { text: conn.remote-addr; font-size: 12px; color: #f1f5f9; vertical-alignment: center; min-width: 170px; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: conn.state; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 1 && root.log-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for glog in root.grouped-logs : Rectangle {
                            height: 36px;
                            background: glog.is-blocked ? #450a0a : #111827;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: glog.domain; font-size: 13px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #0284c7;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.total-queries + (I18n.t(" truy vấn", " queries", " 次查询")); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                if glog.blocked-queries > 0 : Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #dc2626;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.blocked-queries + (I18n.t(" bị chặn", " blocked", " 次拦截")); font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Text { text: (I18n.t("Gần nhất: ", "Last: ", "最近: ")) + glog.last-seen; font-size: 11px; color: #94a3b8; vertical-alignment: center; min-width: 100px; }
                                Text { text: "IP: " + glog.last-ip; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 95px; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 1 && root.log-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for log in root.logs : Rectangle {
                            height: 32px;
                            background: log.is-blocked ? #450a0a : #111827;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: log.timestamp; font-size: 12px; color: #94a3b8; vertical-alignment: center; min-width: 80px; }
                                Text {
                                    text: log.is-blocked ? (I18n.t("[BỊ CHẶN]", "[BLOCKED]", "[已拦截]")) : (I18n.t("[CHO PHÉP]", "[ALLOWED]", "[允许]"));
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    min-width: 85px;
                                    color: log.is-blocked ? #f87171 : #4ade80;
                                }
                                Text { text: log.domain; font-size: 13px; color: #f1f5f9; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: log.source-ip; font-size: 12px; color: #64748b; vertical-alignment: center; min-width: 100px; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 2 : ListView {
                        vertical-stretch: 1;
                        for clog in root.console-logs : Rectangle {
                            height: 30px;
                            background: #020617;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                Text { text: clog.time; font-size: 11px; color: #64748b; vertical-alignment: center; min-width: 70px; }
                                Text {
                                    text: "[" + clog.level + "]";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: clog.level == "ERROR" ? #ef4444 : (clog.level == "WARN" ? #f59e0b : #38bdf8);
                                    vertical-alignment: center;
                                    min-width: 65px;
                                }
                                Text { text: clog.message; font-size: 12px; color: #e2e8f0; vertical-alignment: center; overflow: elide; horizontal-alignment: start; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.active-tab == 3;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;

                        Text { text: I18n.t("⛔ Danh sách chặn tùy chỉnh (Blacklist):", "⛔ Custom Blacklist (Block):", "⛔ 自定义黑名单 (屏蔽):"); font-size: 14px; font-weight: 700; color: #f87171; }
                        HorizontalLayout {
                            spacing: 8px;
                            block-input := LineEdit {
                                placeholder-text: I18n.t("Nhập domain muốn chặn...", "Enter domain to block...", "输入要屏蔽的域名...");
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: I18n.t("➕ Chặn", "➕ Block", "➕ 屏蔽");
                                clicked => {
                                    root.add-custom-rule(block-input.text);
                                    block-input.text = "";
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for rule in root.custom-rules : Rectangle {
                                height: 36px;
                                background: #111827;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    Text { text: "🚫 " + rule; font-size: 12px; color: #fca5a5; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button {
                                        text: I18n.t("Xóa", "Delete", "删除");
                                        clicked => { root.remove-custom-rule(rule); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: #1f2937; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;

                        Text { text: I18n.t("✅ Danh sách cho phép (Whitelist - Ưu tiên cao nhất):", "✅ Whitelist (Always Allow - Highest Priority):", "✅ 白名单 (始终允许 - 最高优先级):"); font-size: 14px; font-weight: 700; color: #4ade80; }
                        HorizontalLayout {
                            spacing: 8px;
                            allow-input := LineEdit {
                                placeholder-text: I18n.t("Nhập domain luôn cho phép...", "Enter domain to always allow...", "输入始终允许的域名...");
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: I18n.t("➕ Cho phép", "➕ Allow", "➕ 允许");
                                clicked => {
                                    root.add-allowed-rule(allow-input.text);
                                    allow-input.text = "";
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for rule in root.allowed-rules : Rectangle {
                                height: 36px;
                                background: #111827;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    Text { text: "✅ " + rule; font-size: 12px; color: #86efac; vertical-alignment: center; horizontal-stretch: 1; }
                                    Button {
                                        text: I18n.t("Xóa", "Delete", "删除");
                                        clicked => { root.remove-allowed-rule(rule); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.active-tab == 4;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.network-wide-adblock ? #38bdf8 : #1f2937;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "🌐 " + (I18n.t("Chống quảng cáo toàn mạng LAN (DNS Proxy Port 53)", "Network-wide LAN Adblocker (Port 53)", "局域网全网去广告 (DNS 代理端口 53)")); font-size: 14px; font-weight: 700; color: #38bdf8; }
                                        Rectangle {
                                            height: 20px;
                                            border-radius: 10px;
                                            background: root.network-wide-adblock ? #059669 : #374151;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: center;
                                                Text { text: root.network-wide-adblock ? (I18n.t("ĐANG HOẠT ĐỘNG", "ACTIVE", "运行中")) : (I18n.t("ĐANG TẮT", "DISABLED", "已关闭")); font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    Text {
                                        text: I18n.t("Mở cổng DNS 53 cho tất cả các thiết bị cùng mạng Wi-Fi (iPhone, Android, Smart TV, PC). Đặt DNS Router về IP máy này để tự động chặn sạch quảng cáo.", "Listen on UDP/TCP port 53 for all LAN devices. Set your Wi-Fi Router DNS to this PC's IP to block ads network-wide.", "向同一 Wi-Fi 网络内的所有设备 (iPhone、Android、智能电视、PC) 开放 DNS 端口 53。将路由器 DNS 指向本机 IP 即可自动屏蔽全网广告。");
                                        font-size: 12px;
                                        color: #94a3b8;
                                    }
                                }
                                Button {
                                    text: root.network-wide-adblock ? (I18n.t("TẮT TÍNH NĂNG", "DISABLE", "关闭功能")) : (I18n.t("BẬT TOÀN MẠNG", "ENABLE", "全网启用"));
                                    clicked => { root.toggle-network-wide-adblock(!root.network-wide-adblock); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    background: #0f172a;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #334155;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: start;
                                        Text { text: (I18n.t("📡 Địa chỉ IP máy chủ LAN: ", "📡 Host Server IP: ", "📡 局域网主机 IP: ")) + root.host-lan-ip + " : 53"; font-size: 12px; font-weight: 800; color: #22c55e; vertical-alignment: center; }
                                    }
                                }
                                Button {
                                    text: root.silent-sinkhole ? (I18n.t("🛡️ Silent Sinkhole: BẬT", "🛡️ Silent Sinkhole: ON", "🛡️ 静默黑洞: 开")) : (I18n.t("🛡️ Silent Sinkhole: TẮT", "🛡️ Silent Sinkhole: OFF", "🛡️ 静默黑洞: 关"));
                                    clicked => { root.toggle-silent-sinkhole(!root.silent-sinkhole); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.attack-detection-enabled ? #10b981 : #1f2937;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "🛡️ " + (I18n.t("Hệ thống Phòng thủ An ninh & Chống Xâm nhập (IDS / IPS / ARP)", "Intrusion Detection & Prevention Defense (IDS / IPS / ARP)", "安全防御与入侵防护系统 (IDS / IPS / ARP)")); font-size: 14px; font-weight: 700; color: #34d399; }
                                Rectangle {
                                    height: 20px;
                                    border-radius: 10px;
                                    background: root.attack-detection-enabled ? #059669 : #374151;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;
                                        Text { text: root.attack-detection-enabled ? (I18n.t("BẢO VỆ TỐI CAO", "MAX SHIELD", "最高防护")) : (I18n.t("ĐANG TẮT", "OFF", "已关闭")); font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0f172a;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #1e293b;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text { text: I18n.t("Phát hiện tấn công (IDS)", "Intrusion Detection (IDS)", "入侵检测 (IDS)"); font-size: 12px; font-weight: 700; color: #38bdf8; }
                                        Text { text: I18n.t("Giám sát DoS Flood, Tunneling, Port Scan & Botnet", "Monitors DoS, Tunneling, Port Scan & Botnet", "监控 DoS 洪水、隧道、端口扫描与僵尸网络"); font-size: 11px; color: #94a3b8; }
                                        Button {
                                            text: root.attack-detection-enabled ? (I18n.t("✅ ĐANG BẬT", "✅ ON", "✅ 已开启")) : (I18n.t("⚪ ĐANG TẮT", "⚪ OFF", "⚪ 已关闭"));
                                            clicked => { root.toggle-attack-detection(!root.attack-detection-enabled); }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0f172a;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #1e293b;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text { text: I18n.t("Tự động khóa IP (IPS)", "Auto-Block Threat (IPS)", "自动封锁 IP (IPS)"); font-size: 12px; font-weight: 700; color: #f87171; }
                                        Text { text: I18n.t("Tự động cô lập nguồn độc hại 5 phút", "Auto-mitigates & drops source IP", "自动隔离恶意源 5 分钟"); font-size: 11px; color: #94a3b8; }
                                        Button {
                                            text: root.auto-block-attacks ? (I18n.t("✅ ĐANG BẬT", "✅ ON", "✅ 已开启")) : (I18n.t("⚪ ĐANG TẮT", "⚪ OFF", "⚪ 已关闭"));
                                            clicked => { root.toggle-auto-block-attacks(!root.auto-block-attacks); }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0f172a;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #1e293b;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text { text: I18n.t("Chống ARP Spoofing", "Anti-ARP Spoofing", "防 ARP 欺骗"); font-size: 12px; font-weight: 700; color: #fbbf24; }
                                        Text { text: I18n.t("Bảo vệ Router Gateway chống nghe lén", "Protects Gateway from MITM snooping", "保护网关路由器免遭窃听"); font-size: 11px; color: #94a3b8; }
                                        Button {
                                            text: root.arp-spoof-detection ? (I18n.t("✅ ĐANG BẬT", "✅ ON", "✅ 已开启")) : (I18n.t("⚪ ĐANG TẮT", "⚪ OFF", "⚪ 已关闭"));
                                            clicked => { root.toggle-arp-spoof-detection(!root.arp-spoof-detection); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            Text { text: "⚙️ " + (I18n.t("Vận hành Hệ thống & Tùy chọn Ứng dụng:", "System Operation & Preferences:", "系统运行与应用偏好:")); font-size: 14px; font-weight: 700; color: #e2e8f0; }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.autostart-enabled ? (I18n.t("✅ Khởi động cùng Windows: BẬT", "✅ Autostart: ON", "✅ 开机自启: 开")) : (I18n.t("⚪ Khởi động cùng Windows: TẮT", "⚪ Autostart: OFF", "⚪ 开机自启: 关"));
                                    clicked => { root.toggle-autostart(!root.autostart-enabled); }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.enable-notifications ? (I18n.t("🔔 Thông báo chặn QC: BẬT", "🔔 Block Notifications: ON", "🔔 拦截广告通知: 开")) : (I18n.t("⚪ Thông báo chặn QC: TẮT", "⚪ Block Notifications: OFF", "⚪ 拦截广告通知: 关"));
                                    clicked => { root.toggle-notifications(!root.enable-notifications); }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.minimize-to-tray-enabled ? (I18n.t("✅ Đóng vào Khay: BẬT", "✅ Close to Tray: ON", "✅ 关闭到托盘: 开")) : (I18n.t("⚪ Đóng vào Khay: TẮT", "⚪ Close to Tray: OFF", "⚪ 关闭到托盘: 关"));
                                    clicked => { root.toggle-minimize-to-tray(!root.minimize-to-tray-enabled); }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: I18n.lang == 0 ? "🌐 Tiếng Việt ➜ English" : (I18n.lang == 1 ? "🌐 English ➜ 中文" : "🌐 中文 ➜ Tiếng Việt");
                                    clicked => { root.change-language(I18n.lang == 0 ? "en" : (I18n.lang == 1 ? "zh" : "vi")); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.minimize-to-tray-on-minimize ? (I18n.t("🔽 Thu nhỏ vào Khay: BẬT", "🔽 Minimize to Tray: ON", "🔽 最小化到托盘: 开")) : (I18n.t("⚪ Thu nhỏ vào Taskbar: TẮT", "⚪ Minimize to Taskbar: OFF", "⚪ 最小化到任务栏: 关"));
                                    clicked => { root.toggle-minimize-to-tray-on-minimize(!root.minimize-to-tray-on-minimize); }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.start-hidden-in-tray ? (I18n.t("👻 Khởi động ẩn trong Khay: BẬT", "👻 Start Hidden in Tray: ON", "👻 启动时隐藏到托盘: 开")) : (I18n.t("⚪ Khởi động hiện cửa sổ: TẮT", "⚪ Start with Window: OFF", "⚪ 启动时显示窗口: 关"));
                                    clicked => { root.toggle-start-hidden-in-tray(!root.start-hidden-in-tray); }
                                }
                            }

                            Text {
                                text: I18n.t("⌨ Phím tắt toàn cục: Ctrl+Alt+S bật/tắt bảo vệ", "⌨ Global hotkey: Ctrl+Alt+S toggles protection", "⌨ 全局快捷键：Ctrl+Alt+S 开关防护");
                                font-size: 10px;
                                color: #64748b;
                            }
                        }
                    }

                    Rectangle {
                        background: #111827;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: center;
                                Text { text: "Shield Ghita v" + root.app-version; font-size: 13px; font-weight: 800; color: #38bdf8; }
                                Text { text: "• Engine: Rust 2021 + Slint UI + Win32 WFP"; font-size: 12px; color: #94a3b8; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.last-update-text; font-size: 12px; font-weight: 700; color: #22c55e; }
                                Button {
                                    text: I18n.t("🌐 Bản mới nhất", "🌐 Latest Release", "🌐 最新版本");
                                    clicked => { root.open-latest-release(); }
                                }
                            }

                            Text {
                                text: I18n.t("Phần mềm bảo vệ an ninh mạng, chống rò rỉ dữ liệu, ngăn chặn tấn công xâm nhập & triệt tiêu 100% quảng cáo toàn mạng LAN thế hệ mới.", "Next-generation cyber shield protecting network privacy, preventing intrusion attacks, and eliminating ads across your entire LAN.", "新一代网络安全防护软件：防止数据泄露、阻止入侵攻击，并彻底消除整个局域网的广告。");
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.is-admin-edition && root.active-tab == 5;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    Text {
                        text: I18n.t("🌐 Web Panel (điện thoại/máy khác trong mạng): ", "🌐 Web Panel (phone/other device on this LAN): ", "🌐 网页面板（局域网内手机/其他设备）: ") + "http://" + root.host-lan-ip + ":2525";
                        font-size: 11px;
                        font-weight: 700;
                        color: #34d399;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("THIẾT BỊ LÂN CẬN (PROXIMITY)", "PROXIMITY NODES", "邻近设备 (PROXIMITY)"); font-size: 11px; font-weight: 700; color: #a78bfa; }
                                Text { text: root.proximity-devices-count; font-size: 24px; font-weight: 800; color: #c084fc; }
                                Text { text: I18n.t("Quét mDNS, SSDP, ARP đa lớp mạng", "Multi-layer mDNS, SSDP & ARP probe", "多层 mDNS、SSDP、ARP 探测"); font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("HỒ SƠ HÀNH VI (BEHAVIOR)", "BEHAVIOR PROFILES", "行为档案 (BEHAVIOR)"); font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: root.behavior-profiles-count; font-size: 24px; font-weight: 800; color: #38bdf8; }
                                Text { text: I18n.t("Baseline lưu lượng & phân tích DGA", "Traffic baseline & DGA analytics", "流量基线与 DGA 分析"); font-size: 11px; color: #64748b; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("MỐI NGUY CAO (HIGH RISK)", "HIGH RISK THREATS", "高危威胁 (HIGH RISK)"); font-size: 11px; font-weight: 700; color: #f87171; }
                                Text { text: root.high-risk-count; font-size: 24px; font-weight: 800; color: #ef4444; }
                                Text { text: I18n.t("Thiết bị có điểm rủi ro >= 50", "Devices with Risk Score >= 50", "风险评分 >= 50 的设备"); font-size: 11px; color: #fca5a5; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("TRẠM PHÁT WI-FI (AIR)", "AMBIENT WI-FI NODES", "周边 Wi-Fi 站点 (AIR)"); font-size: 11px; font-weight: 700; color: #fbbf24; }
                                Text { text: root.wifi-nodes-count; font-size: 24px; font-weight: 800; color: #fbbf24; }
                                Text { text: I18n.t("BSSID & Tín hiệu lân cận", "Nearby BSSIDs & Signal radios", "附近 BSSID 与信号"); font-size: 11px; color: #64748b; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Button {
                            text: root.admin-subview-mode == 0 ? (I18n.t("🧠 Xem Hồ Sơ Hành Vi", "🧠 View Behavior Profiles", "🧠 查看行为档案")) : (I18n.t("📡 Xem Thiết Bị Lân Cận", "📡 View Proximity Nodes", "📡 查看邻近设备"));
                            clicked => { root.admin-subview-mode = root.admin-subview-mode == 0 ? 1 : 0; }
                        }
                        Button {
                            text: root.admin-subview-mode == 2 ? (I18n.t("● 📷 Camera ✓", "● 📷 Camera ✓", "● 📷 摄像头 ✓")) : (I18n.t("📷 Camera", "📷 Camera", "📷 摄像头"));
                            clicked => { root.admin-subview-mode = 2; }
                        }
                        Button {
                            text: I18n.t("🔍 Quét lân cận ngay (Proximity Sweep)", "🔍 Trigger Proximity Sweep", "🔍 立即扫描邻近设备");
                            clicked => { root.trigger-proximity-scan(); }
                        }
                        Button {
                            text: I18n.t("📷 Quét camera", "📷 Scan Cameras", "📷 扫描摄像头");
                            clicked => { root.scan-cameras(); }
                        }
                        Button {
                            text: I18n.t("🔄 Làm mới dữ liệu", "🔄 Refresh Data", "🔄 刷新数据");
                            clicked => { root.refresh-admin-data(); }
                        }
                        Button {
                            text: I18n.t("📦 Sao Lưu", "📦 Backup", "📦 备份");
                            clicked => { root.export-config-backup(); }
                        }
                        Button {
                            text: I18n.t("📥 Phục Hồi", "📥 Restore", "📥 恢复");
                            clicked => { root.import-config-backup(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.admin-subview-mode == 0 ? (I18n.t("Danh sách thiết bị quét lân cận & thăm dò đa giao thức:", "Proximity devices discovered via multi-protocol probes:", "多协议探测发现的邻近设备列表:")) : (root.admin-subview-mode == 1 ? (I18n.t("Hồ sơ phân tích hành vi & nhận diện bất thường từng thiết bị:", "Real-time device behavioral profiling & anomaly detection:", "设备行为分析异常检测档案:")) : (I18n.t("Camera RTSP/ONVIF phát hiện trong mạng — mở bằng VLC hoặc copy URL:", "RTSP/ONVIF cameras found on the network — open in VLC or copy URL:", "网络中发现的 RTSP/ONVIF 摄像头 — 用 VLC 打开或复制 URL:")));
                            font-size: 12px;
                            font-weight: 600;
                            color: #94a3b8;
                        }
                    }

                    if root.admin-subview-mode == 2 && root.camera-list.length == 0 : Text {
                        text: I18n.t("Chưa có camera nào — bấm 📷 Quét camera.", "No cameras yet — press 📷 Scan Cameras.", "尚未发现摄像头 — 请点击 📷 扫描摄像头。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 0 && root.proximity-devices.length == 0 : Text {
                        text: I18n.t("Chưa phát hiện thiết bị lân cận — bấm 🔍 Quét lân cận ngay.", "No proximity nodes yet — press 🔍 Trigger Proximity Sweep.", "尚未发现邻近设备 — 请点击 🔍 立即扫描邻近设备。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 1 && root.behavior-profiles.length == 0 : Text {
                        text: I18n.t("Chưa có hồ sơ hành vi — hồ sơ hình thành khi thiết bị truy vấn DNS.", "No behavior profiles yet — profiles build as devices query DNS.", "暂无行为档案 — 设备发起 DNS 查询后自动生成。");
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for pdev in root.proximity-devices : Rectangle {
                            height: 58px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1f2937;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 220px;
                                    Text { text: pdev.name; font-size: 13px; font-weight: 700; color: #f1f5f9; overflow: elide; }
                                    Text { text: (I18n.t("Hãng: ", "Vendor: ", "厂商: ")) + pdev.vendor; font-size: 11px; color: #38bdf8; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 140px;
                                    Text { text: "IP: " + pdev.ip; font-size: 12px; font-weight: 700; color: #cbd5e1; }
                                    Text { text: "MAC: " + pdev.mac; font-size: 11px; color: #64748b; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 150px;
                                    Text { text: (I18n.t("Giao thức: ", "Proto: ", "协议: ")) + pdev.discovery-method; font-size: 11px; font-weight: 700; color: #a78bfa; overflow: elide; }
                                    Text { text: (I18n.t("Mạng nguồn: ", "Source net: ", "来源网络: ")) + pdev.network-interface; font-size: 11px; color: #94a3b8; overflow: elide; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: (I18n.t("Cổng mở: ", "Ports: ", "开放端口: ")) + pdev.open-ports-str; font-size: 11px; color: #e2e8f0; overflow: elide; }
                                    Text { text: (I18n.t("Thấy lúc: ", "Seen: ", "发现时间: ")) + pdev.last-seen; font-size: 10px; color: #64748b; }
                                }

                                Rectangle {
                                    width: 80px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: pdev.is-online ? #064e3b : #374151;
                                    HorizontalLayout {
                                        alignment: center;
                                         Text { text: pdev.is-online ? (I18n.t("🟢 TRỰC TUYẾN", "🟢 ONLINE", "🟢 在线")) : (I18n.t("🔴 NGOẠI TUYẾN", "🔴 OFFLINE", "🔴 离线")); font-size: 10px; font-weight: 800; color: pdev.is-online ? #34d399 : #94a3b8; vertical-alignment: center; }
                                    }
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.attack-target-ip = pdev.ip;
                                    root.attack-target-name = pdev.name;
                                    root.attack-target-mac = pdev.mac;
                                    root.attack-target-vendor = pdev.vendor;
                                    root.attack-message = "";
                                    root.attack-modal-tab = 2;
                                    root.attack-mode = 1;
                                    root.attack-duration-min = 15;
                                    root.attack-modal-open = true;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "⚔ " + I18n.t("Thông báo đang chạy: ", "Active notices: ", "进行中的通告：") + root.active-attacks-count;
                            font-size: 13px;
                            font-weight: 700;
                            color: root.active-attacks-count > 0 ? #f87171 : #64748b;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: I18n.t("🗑 Hủy hết hạn", "🗑 Clear expired", "🗑 清除过期");
                            clicked => { root.refresh-admin-data(); }
                        }
                    }

                    if root.attack-history.length > 0 : ListView {
                        height: 110px;
                        for atk in root.attack-history : Rectangle {
                            height: 34px;
                            background: atk.is-warning ? #241405 : #2a0808;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: atk.is-warning ? #f59e0b : #ef4444;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                spacing: 10px;
                                alignment: start;
                                Rectangle {
                                    width: 86px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: atk.is-warning ? #d97706 : #dc2626;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: atk.mode-label; font-size: 9px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                                Text { text: atk.target; font-size: 11px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; min-width: 110px; }
                                Text { text: atk.message; font-size: 10px; color: #cbd5e1; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: atk.window-label; font-size: 9px; color: #94a3b8; vertical-alignment: center; min-width: 150px; }
                                Text { text: atk.hits-label; font-size: 10px; color: #38bdf8; vertical-alignment: center; min-width: 50px; }
                                Button {
                                    text: "✖";
                                    width: 30px;
                                    clicked => { root.cancel-attack(atk.target); }
                                }
                            }
                        }
                    }

                    if root.admin-subview-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for prof in root.behavior-profiles : Rectangle {
                            height: 58px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: prof.risk-score >= 50 ? #ef4444 : #1f2937;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 180px;
                                    Text { text: prof.hostname; font-size: 13px; font-weight: 700; color: #f1f5f9; overflow: elide; }
                                    Text { text: "IP: " + prof.ip; font-size: 11px; color: #38bdf8; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 160px;
                                    Text { text: (I18n.t("Phân loại: ", "Class: ", "分类: ")) + prof.category; font-size: 12px; font-weight: 700; color: prof.risk-score >= 50 ? #f87171 : #4ade80; }
                                    Text { text: "Burst QPS: " + prof.burst-qps; font-size: 11px; color: #94a3b8; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 180px;
                                    Text { text: (I18n.t("Tổng: ", "Total: ", "总计: ")) + prof.total-queries + (I18n.t(" | Chặn: ", " | Blocked: ", " | 拦截: ")) + prof.blocked-queries; font-size: 11px; font-weight: 600; color: #cbd5e1; }
                                    Text { text: (I18n.t("Mối nguy: ", "Threats: ", "威胁: ")) + prof.threat-queries + (I18n.t(" mối đe dọa", " flagged", " 个威胁")); font-size: 11px; color: prof.threat-queries > 0 ? #f87171 : #64748b; }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Rectangle {
                                    width: 100px;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: prof.risk-score >= 70 ? #7f1d1d : (prof.risk-score >= 40 ? #78350f : #064e3b);
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: (I18n.t("Rủi ro: ", "Risk: ", "风险: ")) + prof.risk-score + "/100"; font-size: 11px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    if root.admin-subview-mode == 2 && root.camera-list.length > 0 : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: I18n.t("💡 Xem Live & mở VLC: app tự thử không-mật-khẩu + mật khẩu mặc định giúp bạn (Basic/Digest).", "💡 Live view & VLC open: the app auto-tries no-auth and default passwords for you (Basic/Digest).", "💡 实时预览和 VLC 打开：应用自动尝试无密码和默认密码（Basic/Digest）。");
                            font-size: 10px;
                            color: #64748b;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.admin-subview-mode == 2 : ListView {
                        height: 220px;
                        for cam in root.camera-list : Rectangle {
                            height: 46px;
                            background: #111827;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: cam.is-online ? #064e3b : #374151;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 10px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 170px;
                                    Text { text: cam.vendor + "  " + cam.model; font-size: 12px; font-weight: 700; color: #f1f5f9; overflow: elide; }
                                    Text { text: cam.source + (cam.is-online ? "  •  RTSP ✓" : "  •  RTSP ✗"); font-size: 9px; color: cam.is-online ? #34d399 : #94a3b8; }
                                }

                                Text { text: cam.ip; font-size: 12px; font-weight: 700; color: #cbd5e1; vertical-alignment: center; min-width: 120px; }
                                Text { text: cam.rtsp-url; font-size: 10px; color: #38bdf8; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }

                                Button {
                                    text: I18n.t("👁️ Xem Live", "👁️ Live View", "👁️ 实时预览");
                                    clicked => {
                                        root.camera-live-ip = cam.ip;
                                        root.camera-live-vendor = cam.vendor;
                                        root.camera-live-rtsp = cam.rtsp-url;
                                        root.camera-live-title = cam.vendor + " (" + cam.ip + ")";
                                        root.camera-live-status = "Connecting...";
                                        root.camera-live-has-frame = false;
                                        root.camera-security-status = "";
                                        root.camera-live-modal-open = true;
                                        root.start-camera-live-stream(cam.ip, "", "");
                                    }
                                }
                                Button {
                                    text: I18n.t("📋 Copy", "📋 Copy", "📋 复制");
                                    clicked => { root.copy-camera-url(cam.rtsp-url); }
                                }
                                Button {
                                    text: I18n.t("▶ Mở VLC", "▶ Open VLC", "▶ 用 VLC 打开");
                                    clicked => { root.open-camera-stream(cam.rtsp-url); }
                                }
                            }
                        }
                    }
                }

            }
        }

        if root.active-tab == 6 : VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: root.active-diag-view == 0 ? (I18n.t("● ⚡ Đo Tốc Độ DNS", "● ⚡ DNS Benchmark", "● ⚡ DNS 测速")) : (I18n.t("⚡ Đo Tốc Độ DNS", "⚡ DNS Benchmark", "⚡ DNS 测速"));
                    clicked => { root.active-diag-view = 0; }
                }
                Button {
                    text: root.active-diag-view == 1 ? (I18n.t("● 🚀 Test Tốc Độ", "● 🚀 Speed Test", "● 🚀 测速")) : (I18n.t("🚀 Test Tốc Độ", "🚀 Speed Test", "🚀 测速"));
                    clicked => { root.active-diag-view = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.active-diag-view == 0 ? (I18n.t("So sánh tốc độ phân giải DNS với các máy chủ công cộng lớn nhất thế giới:", "Benchmark DNS resolution speeds against major global upstream servers:", "与全球顶级上游公共 DNS 服务器对比解析速度:")) : (I18n.t("Đo tốc độ tải xuống / tải lên Internet qua kết nối đang dùng (Cloudflare):", "Measure Internet download / upload speed on the active connection (Cloudflare):", "测量当前连接的互联网下载 / 上传速度（Cloudflare）:"));
                    font-size: 12px;
                    font-weight: 600;
                    color: #94a3b8;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 64px;
                background: #020617;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1e293b;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;
                    Text { text: "📡 " + (root.net-if-name == "" ? "…" : root.net-if-name); font-size: 12px; font-weight: 700; color: #94a3b8; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: "⬇ " + root.net-down-mbps + " Mbps"; font-size: 20px; font-weight: 800; color: #34d399; vertical-alignment: center; }
                    Text { text: "⬆ " + root.net-up-mbps + " Mbps"; font-size: 20px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                }
            }

            if root.active-diag-view == 0 : VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 10px;
                    height: 38px;
                    Text {
                        text: I18n.t("Tên miền kiểm tra:", "Benchmark Domain:", "测试域名:");
                        font-size: 13px;
                        font-weight: 700;
                        color: #cbd5e1;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.benchmark-domain-input;
                        placeholder-text: "google.com";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.is-running-benchmark ? (I18n.t("⏳ Đang kiểm tra…", "⏳ Testing…", "⏳ 正在测试…")) : (I18n.t("🚀 Bắt đầu Benchmark", "🚀 Run Benchmark", "🚀 开始测速"));
                        clicked => {
                            if !root.is-running-benchmark {
                                root.is-running-benchmark = true;
                                root.run-dns-benchmark(root.benchmark-domain-input);
                            }
                        }
                    }
                }

                if root.dns-benchmarks.length == 0 : Text {
                    text: I18n.t("Bấm '🚀 Bắt đầu Benchmark' để đo độ trễ các máy chủ DNS phổ biến.", "Click '🚀 Run Benchmark' to test response times of popular DNS servers.", "点击'🚀 开始测速'测试常用 DNS 服务器的响应时间。");
                    font-size: 12px;
                    color: #64748b;
                    horizontal-alignment: center;
                }

                ListView {
                    vertical-stretch: 1;
                    for item in root.dns-benchmarks : DnsBenchmarkRow {
                        item: item;
                    }
                }
            }

            if root.active-diag-view == 1 : VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 10px;
                    height: 38px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.is-running-speed ? (I18n.t("⏳ Đang đo…", "⏳ Testing…", "⏳ 正在测速…")) : (I18n.t("🚀 Bắt Đầu Test Tốc Độ", "🚀 Run Speed Test", "🚀 开始测速"));
                        clicked => {
                            if !root.is-running-speed {
                                root.is-running-speed = true;
                                root.run-speed-test();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    height: 95px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: #111827;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 10px;
                            alignment: center;
                            Text { text: I18n.t("TẢI XUỐNG (DOWNLOAD)", "DOWNLOAD", "下载"); font-size: 10px; font-weight: 700; color: #34d399; }
                            Text { text: root.speed-download >= 0 ? (root.speed-download + " Mbps") : "—"; font-size: 24px; font-weight: 800; color: #34d399; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: #111827;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 10px;
                            alignment: center;
                            Text { text: I18n.t("TẢI LÊN (UPLOAD)", "UPLOAD", "上传"); font-size: 10px; font-weight: 700; color: #38bdf8; }
                            Text { text: root.speed-upload >= 0 ? (root.speed-upload + " Mbps") : "—"; font-size: 24px; font-weight: 800; color: #38bdf8; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: #111827;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1f2937;
                        VerticalLayout {
                            padding: 10px;
                            alignment: center;
                            Text { text: I18n.t("ĐỘ TRỄ (PING)", "PING LATENCY", "延迟"); font-size: 10px; font-weight: 700; color: #a78bfa; }
                            Text { text: root.speed-ping-ms >= 0 ? (root.speed-ping-ms + " ms") : "—"; font-size: 24px; font-weight: 800; color: #c084fc; }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #020617;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #1e293b;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: root.speed-detail != "" ? root.speed-detail : I18n.t("Bấm '🚀 Bắt Đầu Test Tốc Độ' để đo. Kết quả chi tiết sẽ hiển thị tại đây.", "Press '🚀 Run Speed Test' to measure. Detailed progress will appear here.", "点击'🚀 开始测速'进行测量。详细进度将在此处显示。");
                            font-size: 11px;
                            color: #94a3b8;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    if root.is-admin-edition && root.attack-modal-open : Rectangle {
        z: 150;
        width: root.width;
        height: root.height;
        background: #000000aa;
        TouchArea {
            clicked => { root.attack-modal-open = false; }
        }
    }

    if root.is-admin-edition && root.attack-modal-open : Rectangle {
        z: 160;
        width: 620px;
        height: 470px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #0d121f;
        border-radius: 14px;
        border-width: 2px;
        border-color: #ef4444;
        drop-shadow-color: #000000cc;
        drop-shadow-blur: 24px;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "⚠️ " + I18n.t("CẢNH BÁO THIẾT BỊ", "DEVICE NOTICE", "设备通告");
                    font-size: 17px;
                    font-weight: 800;
                    color: #f87171;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "✖";
                    width: 36px;
                    clicked => { root.attack-modal-open = false; }
                }
            }

            Text {
                text: root.attack-target-name;
                font-size: 15px;
                font-weight: 800;
                color: #f1f5f9;
                overflow: elide;
            }
            Text {
                text: "IP: " + root.attack-target-ip + "    MAC: " + root.attack-target-mac + "    " + (I18n.t("Hãng: ", "Vendor: ", "厂商: ")) + root.attack-target-vendor;
                font-size: 11px;
                color: #94a3b8;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;
                TabButton {
                    text: I18n.t("ℹ Thông tin", "ℹ Info", "ℹ 信息");
                    active: root.attack-modal-tab == 0;
                    clicked => { root.attack-modal-tab = 0; }
                }
                TabButton {
                    text: I18n.t("📈 Hành vi", "📈 Behavior", "📈 行为");
                    active: root.attack-modal-tab == 1;
                    clicked => { root.attack-modal-tab = 1; }
                }
                TabButton {
                    text: I18n.t("⚠ THÔNG BÁO", "⚠ NOTICE", "⚠ 通告");
                    active: root.attack-modal-tab == 2;
                    active-color: #ef4444;
                    clicked => { root.attack-modal-tab = 2; }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: #0b0f19;
                border-radius: 10px;
                border-width: 1px;
                border-color: #1e293b;
                clip: true;

                if root.attack-modal-tab == 0 : VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.attack-target-name; font-size: 14px; font-weight: 700; color: #f1f5f9; }
                    Text { text: (I18n.t("Hãng: ", "Vendor: ", "厂商: ")) + root.attack-target-vendor; font-size: 12px; color: #38bdf8; }
                    Text { text: "IP: " + root.attack-target-ip; font-size: 12px; color: #cbd5e1; }
                    Text { text: "MAC: " + root.attack-target-mac; font-size: 12px; color: #cbd5e1; }
                    Text {
                        text: I18n.t("Chọn tab ⚠ THÔNG BÁO để gửi trang cảnh báo tới thiết bị này.", "Open the ⚠ ATTACK tab to send a warning page to this device.", "打开 ⚠ 攻击 选项卡以向此设备发送警告页面。");
                        font-size: 11px;
                        color: #64748b;
                        wrap: word-wrap;
                    }
                }

                if root.attack-modal-tab == 1 : VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: I18n.t("Hồ sơ hành vi chi tiết của thiết bị được tổng hợp trong mục 🧠 Xem Hồ Sơ Hành Vi của tab Admin.", "Detailed behavior profiles are aggregated in the 🧠 View Behavior Profiles section of the Admin tab.", "设备的详细行为档案汇总在管理选项卡的 🧠 查看行为档案 中。");
                        font-size: 12px;
                        color: #94a3b8;
                        wrap: word-wrap;
                    }
                }

                if root.attack-modal-tab == 2 : VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: I18n.t("Tin nhắn hiển thị trên trang cảnh báo:", "Message shown on the warning page:", "警告页面显示的消息：");
                        font-size: 12px;
                        font-weight: 700;
                        color: #e2e8f0;
                    }
                    LineEdit {
                        text <=> root.attack-message;
                        placeholder-text: I18n.t("Để trống = tin nhắn mặc định của hệ thống...", "Leave empty for the default system message...", "留空则使用系统默认消息...");
                    }

                    Text {
                        text: I18n.t("📄 Chế độ: Trang cảnh báo (máy đích sẽ thấy trang tin nhắn này)", "📄 Mode: Warning Page (the target will see this message page)", "📄 模式：警告页面（目标设备将显示此消息）");
                        font-size: 12px;
                        font-weight: 700;
                        color: #f59e0b;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.attack-duration-min == 15 ? "⏱ 15' ✓" : "⏱ 15'";
                            clicked => { root.attack-duration-min = 15; }
                        }
                        Button {
                            text: root.attack-duration-min == 30 ? "⏱ 30' ✓" : "⏱ 30'";
                            clicked => { root.attack-duration-min = 30; }
                        }
                        Button {
                            text: root.attack-duration-min == 60 ? "⏱ 60' ✓" : "⏱ 60'";
                            clicked => { root.attack-duration-min = 60; }
                        }
                    }

                    Text {
                        text: I18n.t("Trong thời hạn hiệu lực, toàn bộ DNS của thiết bị này sẽ được điều hướng về máy admin. Chế độ Trang cảnh báo kèm cổng captive-portal để hiện thông báo trên điện thoại/máy đích. HTTPS sẽ hiển thị lỗi chứng chỉ thay vì trang đẹp.", "While active, all DNS of this device is redirected to the admin machine. Warning Page mode also serves a captive-portal page so phones show the notice. HTTPS sites will show a certificate error instead of the styled page.", "生效期间，此设备的所有 DNS 都将被重定向到管理机。警告页面模式还会提供 captive-portal 页面以便手机显示通知。HTTPS 网站将显示证书错误而非美化页面。");
                        font-size: 10px;
                        color: #64748b;
                        wrap: word-wrap;
                    }

                    Button {
                        text: I18n.t("🚀 GỬI THÔNG BÁO", "🚀 SEND NOTICE", "🚀 发送通告");
                        clicked => {
                            root.launch-attack(root.attack-target-ip, root.attack-target-mac, root.attack-message, root.attack-mode, root.attack-duration-min);
                            root.attack-modal-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.is-admin-edition && root.camera-live-modal-open : Rectangle {
        z: 170;
        width: root.width;
        height: root.height;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.camera-live-modal-open = false;
                root.stop-camera-live-stream();
            }
        }

        Rectangle {
            z: 180;
            width: 880px;
            height: 610px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #0d121f;
            border-radius: 14px;
            border-width: 2px;
            border-color: #38bdf8;
            drop-shadow-color: #000000ee;
            drop-shadow-blur: 28px;

            // TouchArea inside intercepts all clicks to prevent backdrop dismissal
            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Rectangle {
                        width: 70px;
                        height: 24px;
                        background: #dc2626;
                        border-radius: 4px;
                        Text {
                            text: "● LIVE";
                            font-size: 11px;
                            font-weight: 800;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.camera-live-title;
                        font-size: 15px;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Button {
                        text: I18n.t("✕ Đóng", "✕ Close", "✕ 关闭");
                        clicked => {
                            root.camera-live-modal-open = false;
                            root.stop-camera-live-stream();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    // Left Video Display
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #020617;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e293b;
                        clip: true;

                        if root.camera-live-has-frame : Image {
                            source: root.camera-live-frame;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }

                        if !root.camera-live-has-frame : VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: root.camera-live-status;
                                font-size: 13px;
                                font-weight: 700;
                                color: #94a3b8;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: I18n.t("Đang tự động quét cổng và giải mã luồng camera (không cần nhập mật khẩu)...", "Auto-probing camera ports & stream (no manual password needed)...", "正在自动探测摄像头端口并解析画面（无需手动输入密码）...");
                                font-size: 11px;
                                color: #64748b;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Right PTZ & Action Control Pad
                    Rectangle {
                        width: 220px;
                        background: #111827;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1f2937;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            Text {
                                text: I18n.t("ĐIỀU KHIỂN (PTZ)", "PTZ CONTROL", "云台控制 (PTZ)");
                                font-size: 11px;
                                font-weight: 800;
                                color: #38bdf8;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: "▲ " + I18n.t("Lên", "Up", "上");
                                    clicked => { root.send-camera-ptz("up"); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                Button {
                                    text: "◄ " + I18n.t("Trái", "Left", "左");
                                    clicked => { root.send-camera-ptz("left"); }
                                }
                                Button {
                                    text: "⏹ " + I18n.t("Dừng", "Stop", "停");
                                    clicked => { root.send-camera-ptz("stop"); }
                                }
                                Button {
                                    text: "► " + I18n.t("Phải", "Right", "右");
                                    clicked => { root.send-camera-ptz("right"); }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: "▼ " + I18n.t("Xuống", "Down", "下");
                                    clicked => { root.send-camera-ptz("down"); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                Button {
                                    text: "+ " + I18n.t("Phóng to", "Zoom In", "放大");
                                    clicked => { root.send-camera-ptz("zoom_in"); }
                                }
                                Button {
                                    text: "- " + I18n.t("Thu nhỏ", "Zoom Out", "缩小");
                                    clicked => { root.send-camera-ptz("zoom_out"); }
                                }
                            }

                            Rectangle { height: 1px; background: #374151; }

                            Button {
                                text: I18n.t("📸 Chụp Ảnh", "📸 Snapshot", "📸 抓图");
                                clicked => { root.save-camera-snapshot(root.camera-live-ip); }
                            }

                            Button {
                                text: I18n.t("⚡ Khởi Động Lại", "⚡ Reboot", "⚡ 重启设备");
                                clicked => { root.send-camera-ptz("reboot"); }
                            }

                            Button {
                                text: I18n.t("▶ Mở Trình Phát Ngoài", "▶ Open External VLC", "▶ 外部播放器");
                                clicked => { root.open-camera-stream(root.camera-live-rtsp); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Button {
                        text: I18n.t("🔄 Thử Lại", "🔄 Retry", "🔄 重试");
                        clicked => {
                            root.camera-live-status = "Connecting...";
                            root.start-camera-live-stream(root.camera-live-ip, "", "");
                        }
                    }

                    Button {
                        text: I18n.t("🛡️ Chẩn Đoán Camera", "🛡️ Camera Diagnosis", "🛡️ 诊断摄像头");
                        clicked => {
                            root.audit-camera-security(root.camera-live-ip);
                        }
                    }
                }

                if root.camera-security-status != "" : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: root.camera-security-status;
                        font-size: 11px;
                        font-weight: 700;
                        color: root.camera-security-is-vulnerable ? #ef4444 : #10b981;
                        horizontal-alignment: center;
                    }
                }

                if root.camera-security-status != "" && !root.camera-security-is-vulnerable : Rectangle {
                    background: #111827;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #334155;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: I18n.t("Mật khẩu đúng của camera (lưu 1 lần, xem mãi):", "The camera's real password (saved once, view forever):", "Mật khẩu đúng của camera (lưu 1 lần, xem mãi):");
                            font-size: 11px;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.camera-save-user;
                            placeholder-text: "admin";
                            width: 80px;
                        }
                        LineEdit {
                            text <=> root.camera-save-pass;
                            placeholder-text: I18n.t("mk cũ; mk khác…", "pass; another…", "mk cũ; mk khác…");
                            width: 160px;
                            input-type: password;
                        }
                        Button {
                            text: I18n.t("💾 Lưu & Xem", "💾 Save & View", "💾 保存并查看");
                            clicked => {
                                root.save-camera-credential(root.camera-live-ip, root.camera-save-user, root.camera-save-pass);
                                root.camera-save-user = "";
                                root.camera-save-pass = "";
                                root.stop-camera-live-stream();
                                root.start-camera-live-stream(root.camera-live-ip, "", "");
                            }
                        }
                    }
                }
            }
        }
    }
}
