import { Button, ListView, CheckBox } from "std-widgets.slint";
import { I18n, RamProcessItem } from "common.slint";

component RamStatRow inherits Rectangle {
    in property <string> label;
    in property <float> value-mb: 0;
    in property <float> total-mb: 1;
    in property <color> bar-color: #38bdf8;

    height: 26px;
    HorizontalLayout {
        spacing: 10px;
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.label;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 600;
            width: 150px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            Rectangle {
                width: parent.width;
                height: 10px;
                y: (parent.height - self.height) / 2;
                background: #1f2937;
                border-radius: 4px;
                Rectangle {
                    width: root.total-mb > 0 ? parent.width * Math.min(1.0, root.value-mb / root.total-mb) : 0px;
                    background: root.bar-color;
                    border-radius: 4px;
                }
            }
        }
        Text {
            text: Math.round(root.value-mb) + " MB";
            color: #e2e8f0;
            font-size: 11px;
            font-weight: 700;
            width: 90px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component RamMapTab inherits Rectangle {
    in property <float> total-mb: 0;
    in property <float> available-mb: 0;
    in property <float> active-mb: 0;
    in property <float> standby-mb: 0;
    in property <float> modified-mb: 0;
    in property <float> free-mb: 0;
    in property <float> zero-mb: 0;
    in property <float> page-cache-mb: 0;
    in property <float> kernel-mb: 0;
    in property <float> commit-mb: 0;
    in property <float> commit-limit-mb: 0;
    in property <bool> lists-available: true;
    in property <[RamProcessItem]> processes;
    in property <string> last-action: "";
    in property <bool> is-busy: false;
    in property <bool> auto-clean: false;
    in property <int> threat-count: 0;

    callback empty-op(int);
    callback scan-memory();
    callback toggle-auto-clean(bool);

    in property <string> used-pct-text: root.total-mb > 0
        ? Math.round(100 * (root.total-mb - root.available-mb) / root.total-mb) + "%"
        : "—";

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            height: 78px;

            Rectangle {
                horizontal-stretch: 1;
                background: #111827;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1f2937;
                VerticalLayout {
                    padding: 10px;
                    alignment: center;
                    Text { text: I18n.t("TỔNG RAM", "TOTAL RAM", "总内存"); font-size: 10px; font-weight: 700; color: #64748b; }
                    Text { text: Math.round(root.total-mb) + " MB"; font-size: 17px; font-weight: 800; color: #38bdf8; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #111827;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1f2937;
                VerticalLayout {
                    padding: 10px;
                    alignment: center;
                    Text { text: I18n.t("CÒN TRỐNG", "AVAILABLE", "可用"); font-size: 10px; font-weight: 700; color: #64748b; }
                    Text { text: Math.round(root.available-mb) + " MB"; font-size: 17px; font-weight: 800; color: #34d399; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #111827;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1f2937;
                VerticalLayout {
                    padding: 10px;
                    alignment: center;
                    Text { text: I18n.t("ĐANG DÙNG", "IN USE", "使用中"); font-size: 10px; font-weight: 700; color: #64748b; }
                    Text { text: root.used-pct-text; font-size: 17px; font-weight: 800; color: #f472b6; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #111827;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1f2937;
                VerticalLayout {
                    padding: 10px;
                    alignment: center;
                    Text { text: I18n.t("COMMIT", "COMMIT", "提交"); font-size: 10px; font-weight: 700; color: #64748b; }
                    Text { text: Math.round(root.commit-mb) + " / " + Math.round(root.commit-limit-mb) + " MB"; font-size: 17px; font-weight: 800; color: #f59e0b; }
                }
            }
        }

        Text {
            text: I18n.t("📊 PHÂN BỔ BỘ NHỚ VẬT LÝ", "📊 PHYSICAL MEMORY USE COUNTS", "📊 物理内存分配");
            font-size: 12px;
            font-weight: 800;
            color: #38bdf8;
        }
        Rectangle {
            background: #111827;
            border-radius: 8px;
            border-width: 1px;
            border-color: #1f2937;
            height: root.lists-available ? 186px : 62px;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                RamStatRow { label: I18n.t("Active (đang dùng)", "Active (in use)", "活动（使用中）"); value-mb: root.active-mb; total-mb: root.total-mb; bar-color: #38bdf8; }
                if root.lists-available : RamStatRow { label: I18n.t("Standby (chờ thu)", "Standby (cached)", "待机（可回收）"); value-mb: root.standby-mb; total-mb: root.total-mb; bar-color: #a78bfa; }
                if root.lists-available : RamStatRow { label: I18n.t("Modified (chờ ghi)", "Modified (dirty)", "已修改（待写回）"); value-mb: root.modified-mb; total-mb: root.total-mb; bar-color: #fbbf24; }
                if root.lists-available : RamStatRow { label: I18n.t("Free (trống)", "Free", "空闲"); value-mb: root.free-mb; total-mb: root.total-mb; bar-color: #34d399; }
                if root.lists-available : RamStatRow { label: I18n.t("Zero (đã xoá sạch)", "Zero (zeroed)", "零页"); value-mb: root.zero-mb; total-mb: root.total-mb; bar-color: #64748b; }
                RamStatRow { label: I18n.t("Page Cache + Kernel", "Page Cache + Kernel", "系统缓存 + 内核"); value-mb: root.page-cache-mb + root.kernel-mb; total-mb: root.total-mb; bar-color: #f97316; }
            }
        }
        if !root.lists-available : Text {
            text: I18n.t("⚠ Windows không cung cấp chi tiết trang nhớ — chỉ hiện số tổng.", "⚠ Page-list details unavailable from Windows — totals only.", "⚠ 无法获取页面明细 — 仅显示总量。");
            font-size: 10px;
            color: #64748b;
        }

        Text {
            text: I18n.t("🧹 GIẢI PHÓNG RAM (RAMMap Empty)", "🧹 FREE RAM (RAMMap Empty)", "🧹 释放内存（RAMMap Empty）");
            font-size: 12px;
            font-weight: 800;
            color: #34d399;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: I18n.t("🗜 Working Sets", "🗜 Working Sets", "🗜 工作集");
                enabled: !root.is-busy;
                clicked => { root.empty-op(0); }
            }
            Button {
                text: I18n.t("⚙ System WS", "⚙ System WS", "⚙ 系统工作集");
                enabled: !root.is-busy;
                clicked => { root.empty-op(1); }
            }
            Button {
                text: I18n.t("📝 Modified List", "📝 Modified List", "📝 修改页表");
                enabled: !root.is-busy;
                clicked => { root.empty-op(2); }
            }
            Button {
                text: I18n.t("🧹 Standby List", "🧹 Standby List", "🧹 Dự trữ");
                enabled: !root.is-busy;
                clicked => { root.empty-op(3); }
            }
            Button {
                text: I18n.t("🎯 P0 Standby", "🎯 P0 Standby", "🎯 Dự trữ P0");
                enabled: !root.is-busy;
                clicked => { root.empty-op(4); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 10px;
            CheckBox {
                checked: root.auto-clean;
                text: I18n.t("Tự dọn khi RAM trống < 512MB", "Auto-clean when free RAM < 512MB", "空闲内存低于 512MB 时自动清理");
                toggled => { root.toggle-auto-clean(!root.auto-clean); }
            }
            Button {
                text: root.is-busy ? I18n.t("⏳ Đang quét…", "⏳ Scanning…", "⏳ 正在扫描…")
                                   : (root.threat-count > 0
                                      ? I18n.t("🛡 Soi bộ nhớ (" + root.threat-count + " nghi vấn)", "🛡 Scan Memory (" + root.threat-count + " suspect)", "🛡 内存扫描（" + root.threat-count + " 可疑）")
                                      : I18n.t("🛡 Soi bộ nhớ lạ", "🛡 Scan Memory", "🛡 内存扫描"));
                enabled: !root.is-busy;
                clicked => { root.scan-memory(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.last-action != "" : Text {
            text: root.last-action;
            font-size: 11px;
            color: #86efac;
            wrap: word-wrap;
        }

        Text {
            text: I18n.t("📋 TIẾN TRÌNH DÙNG NHIỀU RAM NHẤT", "📋 TOP PROCESSES BY WORKING SET", "📋 按工作集排序的进程");
            font-size: 12px;
            font-weight: 800;
            color: #a78bfa;
        }
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #111827;
            border-radius: 8px;
            border-width: 1px;
            border-color: #1f2937;
            clip: true;
            ListView {
                for p in root.processes : Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        spacing: 10px;
                        padding-left: 6px;
                        padding-right: 6px;
                        Text { text: p.name; color: #e2e8f0; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: "PID " + p.pid; color: #64748b; font-size: 10px; vertical-alignment: center; width: 80px; }
                        Text { text: Math.round(p.working-set-mb) + " MB"; color: #a78bfa; font-size: 11px; font-weight: 700; vertical-alignment: center; width: 90px; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
}
