import { Button } from "std-widgets.slint";
import { I18n, Theme } from "common.slint";

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    callback clicked <=> touch.clicked;

    border-radius: 8px;
    // Track 5: has-hover làm nền sáng nhẹ (~8%) theo token Theme
    background: root.active
        ? (touch.has-hover ? Theme.surface-hover-strong : Theme.bg-card)
        : (touch.has-hover ? Theme.surface-hover : Theme.bg-panel);
    border-width: 1px;
    border-color: root.active ? root.active-color : Theme.border;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 800 : 600;
            color: root.active ? root.active-color : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component TooltipBadge inherits Rectangle {
    in property <string> tip;
    in property <string> icon: "ⓘ";

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: badge-touch.has-hover ? Theme.surface-hover-strong : Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-strong;

    badge-touch := TouchArea { }

    Text {
        text: root.icon;
        font-size: 9px;
        color: badge-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if badge-touch.has-hover : Rectangle {
        y: 22px;
        width: 320px;
        height: tip-text.preferred-height + 12px;
        x: (parent.width - self.width) / 2;
        background: Theme.bg-chrome;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-color: Theme.shadow-deep;
        drop-shadow-blur: 12px;
        tip-text := Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.tip;
            font-size: 10px;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
    }
}

// Track 5: Spinner — glyph nửa tròn "quay" báo trạng thái đang quét.
// Lưu ý: quay bằng rotation-angle không khả dụng trên Rectangle trong Slint 1.8
// (cargo check bắt lỗi thật) nên dùng cách đổi glyph tuần tự ◐◓◑◒
// (timer 250ms/lần) — nhìn như đang quay, chạy được trên mọi bản Slint.
export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> glyph-color: Theme.accent;
    in property <bool> running: true;

    width: root.size;
    height: root.size;
    background: transparent;

    property <int> frame: 0;

    Timer {
        interval: 250ms;
        running: root.running;
        triggered => { root.frame = root.frame >= 3 ? 0 : root.frame + 1; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.frame == 0 ? "◐" : root.frame == 1 ? "◓" : (root.frame == 2 ? "◑" : "◒");
        font-size: parent.size * 0.9;
        color: root.glyph-color;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component StatCard inherits Rectangle {
    in property <string> card-title;
    in property <string> big-value;
    in property <color> accent: Theme.accent;
    in property <string> sub1;
    in property <color> sub1-color: Theme.text-muted;
    in property <string> sub2;
    in property <color> sub2-color: Theme.text-muted;

    height: 118px;
    background: stat-touch.has-hover ? Theme.surface-hover : Theme.bg-card-alt;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    animate background { duration: 120ms; }

    stat-touch := TouchArea { }

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.card-title; font-size: 11px; font-weight: 700; color: Theme.text-secondary; }
        Text { text: root.big-value; font-size: 26px; font-weight: 800; color: root.accent; }
        Text { text: root.sub1; font-size: 11px; color: root.sub1-color; overflow: elide; }
        Text { text: root.sub2; font-size: 11px; color: root.sub2-color; overflow: elide; }
    }
}

// Track 4 (0.1.5-alpha2): icon button with a floating hover tooltip.
// The TouchArea sits ON TOP of the Button (hover never reaches an area below a
// widget) and forwards clicks to the same root callback.
export component TooltipButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback clicked;

    btn := Button {
        text: root.text;
        clicked => { root.clicked(); }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if ta.has-hover : Rectangle {
        y: -26px;
        width: tip-text.preferred-width + 16px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        background: Theme.bg-chrome;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border-strong;
        tip-text := Text {
            text: root.tip;
            font-size: 10px;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
