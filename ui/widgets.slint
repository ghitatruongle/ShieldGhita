import { I18n, Theme } from "common.slint";

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> active-color: #38bdf8;
    callback clicked <=> touch.clicked;

    border-radius: 8px;
    // Track 5: has-hover làm nền sáng nhẹ (~8%) theo token Theme
    background: root.active
        ? (touch.has-hover ? Theme.surface-hover-strong : #1e293b)
        : (touch.has-hover ? Theme.surface-hover : #0f172a);
    border-width: 1px;
    border-color: root.active ? root.active-color : #1f2937;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 800 : 600;
            color: root.active ? root.active-color : #94a3b8;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Track 5: Spinner — glyph nửa tròn "quay" báo trạng thái đang quét.
// Lưu ý: quay bằng rotation-angle không khả dụng trên Rectangle trong Slint 1.8
// (cargo check bắt lỗi thật) nên dùng cách đổi glyph tuần tự ◐◓◑◒
// (timer 250ms/lần) — nhìn như đang quay, chạy được trên mọi bản Slint.
export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> glyph-color: Theme.accent;
    in property <bool> running: true;

    width: root.size;
    height: root.size;
    background: transparent;

    property <int> frame: 0;

    Timer {
        interval: 250ms;
        running: root.running;
        triggered => { root.frame = root.frame >= 3 ? 0 : root.frame + 1; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.frame == 0 ? "◐" : root.frame == 1 ? "◓" : (root.frame == 2 ? "◑" : "◒");
        font-size: parent.size * 0.9;
        color: root.glyph-color;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component StatCard inherits Rectangle {
    in property <string> card-title;
    in property <string> big-value;
    in property <color> accent: #38bdf8;
    in property <string> sub1;
    in property <color> sub1-color: #64748b;
    in property <string> sub2;
    in property <color> sub2-color: #64748b;

    height: 118px;
    background: #111827;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1f2937;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.card-title; font-size: 11px; font-weight: 700; color: #94a3b8; }
        Text { text: root.big-value; font-size: 26px; font-weight: 800; color: root.accent; }
        Text { text: root.sub1; font-size: 11px; color: root.sub1-color; overflow: elide; }
        Text { text: root.sub2; font-size: 11px; color: root.sub2-color; overflow: elide; }
    }
}
