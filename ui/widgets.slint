import { I18n } from "common.slint";

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> active-color: #38bdf8;
    callback clicked <=> touch.clicked;

    border-radius: 8px;
    background: root.active ? #1e293b : #0f172a;
    border-width: 1px;
    border-color: root.active ? root.active-color : #1f2937;
    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: root.active ? 800 : 600;
            color: root.active ? root.active-color : #94a3b8;
            vertical-alignment: center;
        }
    }
}

export component StatCard inherits Rectangle {
    in property <string> card-title;
    in property <string> big-value;
    in property <color> accent: #38bdf8;
    in property <string> sub1;
    in property <color> sub1-color: #64748b;
    in property <string> sub2;
    in property <color> sub2-color: #64748b;

    height: 118px;
    background: #111827;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1f2937;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.card-title; font-size: 11px; font-weight: 700; color: #94a3b8; }
        Text { text: root.big-value; font-size: 26px; font-weight: 800; color: root.accent; }
        Text { text: root.sub1; font-size: 11px; color: root.sub1-color; overflow: elide; }
        Text { text: root.sub2; font-size: 11px; color: root.sub2-color; overflow: elide; }
    }
}
