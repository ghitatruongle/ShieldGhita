import { Button, ListView, ScrollView } from "std-widgets.slint";
import { I18n, PentestFindingItem, Theme } from "common.slint";

component HardenRow inherits Rectangle {
    in property <PentestFindingItem> item;

    height: 84px;
    background: Theme.bg-card-alt;
    border-radius: 8px;
    border-width: 1px;
    border-color: item.severity == "CRITICAL" ? Theme.danger-solid :
                  item.severity == "HIGH" ? Theme.orange-deep :
                  item.severity == "MEDIUM" ? Theme.amber-deep : Theme.border-strong;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 78px;
            height: 24px;
            border-radius: 6px;
            background: item.severity == "CRITICAL" ? Theme.danger-dim :
                        item.severity == "HIGH" ? Theme.orange-dim :
                        item.severity == "MEDIUM" ? Theme.warn-dim : Theme.blue-dim;
            border-width: 1px;
            border-color: item.severity == "CRITICAL" ? Theme.danger :
                          item.severity == "HIGH" ? Theme.orange :
                          item.severity == "MEDIUM" ? Theme.warning-deep : Theme.blue-mid;

            Text {
                text: item.severity;
                font-size: 9px;
                font-weight: 800;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: item.detail;
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: item.recommendation;
                font-size: 11px;
                color: Theme.text-soft;
                overflow: elide;
                wrap: word-wrap;
                max-height: 30px;
            }

            Text {
                text: "🛠 " + item.category + " • " + item.target;
                font-size: 10px;
                color: Theme.ok-text;
                overflow: elide;
            }
        }
    }
}

export component HardeningTab inherits Rectangle {
    in-out property <bool> harden-busy: false;
    in-out property <string> harden-status: "";
    in-out property <[PentestFindingItem]> harden-findings;

    callback harden-audit-persistence();
    callback harden-audit-eventlog();
    callback harden-audit-usb();
    callback harden-selfhash();
    callback harden-fix(string);
    callback harden-rollback(string);

    ScrollView {
        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: I18n.t4("🧱 CHỐNG HACK CHUYÊN SÂU", "🧱 DEEP HARDENING", "🧱 深度加固", "🧱 ГЛУБОКОЕ УКРЕПЛЕНИЕ");
                        font-size: 15px;
                        font-weight: 800;
                        color: Theme.warning;
                    }

                    Text {
                        text: I18n.t4("Rà điểm thường trú (Run keys, lịch tác vụ, dịch vụ) • Giám sát Event Log (brute-force 4625, dịch vụ mới 7045) • Lịch sử USB • Nguyên vẹn tệp thực thi", "Persistence sweep (Run keys, tasks, services) • Event Log watch (brute-force 4625, new services 7045) • USB history • Executable integrity", "持久化扫描（启动键、计划任务、服务）• 事件日志监控（4625 暴力破解、7045 新服务）• USB 历史 • 可执行文件完整性", "Поиск закрепления (Run-ключи, задачи, службы) • Журнал событий (4625/7045) • История USB • Целостность исполняемого файла");
                        font-size: 11px;
                        color: Theme.text-secondary;
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Button {
                    text: I18n.t4("🧩 Rà điểm thường trú", "🧩 Persistence sweep", "🧩 持久化扫描", "🧩 Закрепление");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-audit-persistence(); }
                }

                Button {
                    text: I18n.t4("📜 Event Log", "📜 Event Log", "📜 事件日志", "📜 Журнал событий");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-audit-eventlog(); }
                }

                Button {
                    text: I18n.t4("🔌 Lịch sử USB", "🔌 USB history", "🔌 USB 历史", "🔌 История USB");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-audit-usb(); }
                }

                Button {
                    text: I18n.t4("🧬 Kiểm tra nguyên vẹn app", "🧬 App integrity check", "🧬 应用完整性检查", "🧬 Целостность приложения");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-selfhash(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: I18n.t4("🔧 Khắc phục:", "🔧 Fix:", "🔧 修复：", "🔧 Исправить:");
                    font-size: 12px;
                    font-weight: 800;
                    color: Theme.mint;
                    vertical-alignment: center;
                }

                Button {
                    text: "SMBv1";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("smbv1"); }
                }
                Button {
                    text: "RDP NLA";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("rdp_nla"); }
                }
                Button {
                    text: "LSA";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("lsa_ppl"); }
                }
                Button {
                    text: "UAC";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("uac_enable"); }
                }
                Button {
                    text: I18n.t4("Tắt AutoRun", "AutoRun off", "关闭AutoRun", "Автозапуск выкл");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("autorun_off"); }
                }
                Button {
                    text: I18n.t4("Chặn ẩn danh", "Block anonymous", "阻止匿名", "Аноним выкл");
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("restrict_anon"); }
                }
                Button {
                    text: "LLMNR";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("llmnr_off"); }
                }
                Button {
                    text: "mDNS";
                    enabled: !root.harden-busy;
                    clicked => { root.harden-fix("mdns_off"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: I18n.t4("↩ Hoàn tác:", "↩ Undo:", "↩ 撤销：", "↩ Отменить:");
                    font-size: 12px;
                    font-weight: 800;
                    color: Theme.warning;
                    vertical-alignment: center;
                }

                Button { text: "SMBv1"; enabled: !root.harden-busy; clicked => { root.harden-rollback("smbv1"); } }
                Button { text: "RDP NLA"; enabled: !root.harden-busy; clicked => { root.harden-rollback("rdp_nla"); } }
                Button { text: "LSA"; enabled: !root.harden-busy; clicked => { root.harden-rollback("lsa_ppl"); } }
                Button { text: "UAC"; enabled: !root.harden-busy; clicked => { root.harden-rollback("uac_enable"); } }
                Button { text: "LLMNR"; enabled: !root.harden-busy; clicked => { root.harden-rollback("llmnr_off"); } }
                Button { text: "mDNS"; enabled: !root.harden-busy; clicked => { root.harden-rollback("mdns_off"); } }
                Button { text: "AutoRun"; enabled: !root.harden-busy; clicked => { root.harden-rollback("autorun_off"); } }
                Button { text: "Anonymous"; enabled: !root.harden-busy; clicked => { root.harden-rollback("restrict_anon"); } }
            }

            if root.harden-status != "" : Rectangle {
                height: 40px;
                background: Theme.bg-panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.accent-solid;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: center;

                    Text {
                        text: root.harden-status;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.accent;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }

            if root.harden-findings.length == 0 && !root.harden-busy : Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-card-alt;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "🧱";
                        font-size: 38px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: I18n.t4("Chọn một kiểm tra phía trên để bắt đầu. Kết quả xếp theo mức độ nghiêm trọng.", "Pick a check above to start. Results sorted by severity.", "选择上方一项检查开始。结果按严重程度排序。", "Выберите проверку выше. Результаты по серьёзности.");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            if root.harden-findings.length > 0 : ListView {
                vertical-stretch: 1;
                for item in root.harden-findings : HardenRow {
                    item: item;
                }
            }
        }
    }
}
