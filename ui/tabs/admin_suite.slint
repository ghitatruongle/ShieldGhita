// 0.1.5-alpha2 Track 3: extracted from app_window.slint — the composition
// root keeps the AppWindow property surface; this file owns tab content.
import { Button, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { I18n, Theme } from "../common.slint";
import { AttackHistoryItem, BehaviorProfileItem, CameraItem, ProximityDeviceItem } from "../common.slint";
import { TabButton, StatCard, Spinner } from "../widgets.slint";
export component AdminSuiteTab inherits Rectangle {
    in property <bool> extra-visible: true;
    in-out property <int> active-attacks-count;
    in-out property <int> admin-subview-mode;
    in-out property <int> attack-duration-min;
    in-out property <[AttackHistoryItem]> attack-history;
    in-out property <string> attack-message;
    in-out property <bool> attack-modal-open;
    in-out property <int> attack-modal-tab;
    in-out property <int> attack-mode;
    in-out property <string> attack-target-ip;
    in-out property <string> attack-target-mac;
    in-out property <string> attack-target-name;
    in-out property <string> attack-target-vendor;
    in-out property <[BehaviorProfileItem]> behavior-profiles;
    in-out property <int> behavior-profiles-count;
    in-out property <[CameraItem]> camera-list;
    in-out property <bool> camera-live-has-frame;
    in-out property <string> camera-live-ip;
    in-out property <bool> camera-live-modal-open;
    in-out property <string> camera-live-rtsp;
    in-out property <string> camera-live-status;
    in-out property <string> camera-live-title;
    in-out property <string> camera-live-vendor;
    in-out property <string> camera-security-status;
    callback cancel-attack(string);
    callback copy-camera-url(string);
    callback export-config-backup();
    in-out property <int> high-risk-count;
    in-out property <string> host-lan-ip;
    callback import-config-backup();
    in-out property <bool> is-scanning-cameras;
    callback open-camera-stream(string);
    in-out property <image> panel-qr-image;
    in-out property <[ProximityDeviceItem]> proximity-devices;
    in-out property <int> proximity-devices-count;
    callback refresh-admin-data();
    callback scan-cameras();
    callback start-camera-live-stream(string, string, string);
    callback trigger-proximity-scan();
    in-out property <int> wifi-nodes-count;

                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    Text {
                        text: I18n.t("🌐 Web Panel (điện thoại/máy khác trong mạng): ", "🌐 Web Panel (phone/other device on this LAN): ", "🌐 网页面板（局域网内手机/其他设备）: ") + "https://" + root.host-lan-ip + ":2525";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.success;
                        horizontal-alignment: center;
                    }

                    if root.panel-qr-image.width > 2 : HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            width: 214px;
                            spacing: 6px;
                            alignment: center;

                            Rectangle {
                                width: 214px;
                                height: 214px;
                                background: Theme.white;
                                border-radius: 8px;
                                clip: true;

                                Image {
                                    source: root.panel-qr-image;
                                    width: 214px;
                                    height: 214px;
                                    image-rendering: pixelated;
                                }
                            }

                            Text {
                                text: I18n.t("📷 Quét QR bằng điện thoại để mở panel", "📷 Scan this QR with your phone to open the panel", "📷 用手机扫描二维码打开面板");
                                font-size: 10px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("THIẾT BỊ LÂN CẬN (PROXIMITY)", "PROXIMITY NODES", "邻近设备 (PROXIMITY)"); font-size: 11px; font-weight: 700; color: Theme.violet; }
                                Text { text: root.proximity-devices-count; font-size: 24px; font-weight: 800; color: Theme.violet-light; }
                                Text { text: I18n.t("Quét mDNS, SSDP, ARP đa lớp mạng", "Multi-layer mDNS, SSDP & ARP probe", "多层 mDNS、SSDP、ARP 探测"); font-size: 11px; color: Theme.text-muted; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("HỒ SƠ HÀNH VI (BEHAVIOR)", "BEHAVIOR PROFILES", "行为档案 (BEHAVIOR)"); font-size: 11px; font-weight: 700; color: Theme.accent; }
                                Text { text: root.behavior-profiles-count; font-size: 24px; font-weight: 800; color: Theme.accent; }
                                Text { text: I18n.t("Baseline lưu lượng & phân tích DGA", "Traffic baseline & DGA analytics", "流量基线与 DGA 分析"); font-size: 11px; color: Theme.text-muted; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("MỐI NGUY CAO (HIGH RISK)", "HIGH RISK THREATS", "高危威胁 (HIGH RISK)"); font-size: 11px; font-weight: 700; color: Theme.danger-soft; }
                                Text { text: root.high-risk-count; font-size: 24px; font-weight: 800; color: Theme.danger; }
                                Text { text: I18n.t("Thiết bị có điểm rủi ro >= 50", "Devices with Risk Score >= 50", "风险评分 >= 50 的设备"); font-size: 11px; color: Theme.danger-text; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 90px;
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: I18n.t("TRẠM PHÁT WI-FI (AIR)", "AMBIENT WI-FI NODES", "周边 Wi-Fi 站点 (AIR)"); font-size: 11px; font-weight: 700; color: Theme.warning; }
                                Text { text: root.wifi-nodes-count; font-size: 24px; font-weight: 800; color: Theme.warning; }
                                Text { text: I18n.t("BSSID & Tín hiệu lân cận", "Nearby BSSIDs & Signal radios", "附近 BSSID 与信号"); font-size: 11px; color: Theme.text-muted; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Button {
                            text: root.admin-subview-mode == 0 ? (I18n.t("🧠 Xem Hồ Sơ Hành Vi", "🧠 View Behavior Profiles", "🧠 查看行为档案")) : (I18n.t("📡 Xem Thiết Bị Lân Cận", "📡 View Proximity Nodes", "📡 查看邻近设备"));
                            clicked => { root.admin-subview-mode = root.admin-subview-mode == 0 ? 1 : 0; }
                        }
                        Button {
                            text: root.admin-subview-mode == 2 ? (I18n.t("● 📷 Camera ✓", "● 📷 Camera ✓", "● 📷 摄像头 ✓")) : (I18n.t("📷 Camera", "📷 Camera", "📷 摄像头"));
                            clicked => { root.admin-subview-mode = 2; }
                        }
                        Button {
                            text: I18n.t("🔍 Quét lân cận ngay (Proximity Sweep)", "🔍 Trigger Proximity Sweep", "🔍 立即扫描邻近设备");
                            clicked => { root.trigger-proximity-scan(); }
                        }
                        Button {
                            text: root.is-scanning-cameras ? I18n.t("⏳ Đang quét camera…", "⏳ Scanning cameras…", "⏳ 正在扫描摄像头…") : I18n.t("📷 Quét camera", "📷 Scan Cameras", "📷 扫描摄像头");
                            enabled: !root.is-scanning-cameras;
                            clicked => { root.scan-cameras(); }
                        }
                        Button {
                            text: I18n.t("🔄 Làm mới dữ liệu", "🔄 Refresh Data", "🔄 刷新数据");
                            clicked => { root.refresh-admin-data(); }
                        }
                        Button {
                            text: I18n.t("📦 Sao Lưu", "📦 Backup", "📦 备份");
                            clicked => { root.export-config-backup(); }
                        }
                        Button {
                            text: I18n.t("📥 Phục Hồi", "📥 Restore", "📥 恢复");
                            clicked => { root.import-config-backup(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.admin-subview-mode == 0 ? (I18n.t("Danh sách thiết bị quét lân cận & thăm dò đa giao thức:", "Proximity devices discovered via multi-protocol probes:", "多协议探测发现的邻近设备列表:")) : (root.admin-subview-mode == 1 ? (I18n.t("Hồ sơ phân tích hành vi & nhận diện bất thường từng thiết bị:", "Real-time device behavioral profiling & anomaly detection:", "设备行为分析异常检测档案:")) : (I18n.t("Camera RTSP/ONVIF phát hiện trong mạng — mở bằng VLC hoặc copy URL:", "RTSP/ONVIF cameras found on the network — open in VLC or copy URL:", "网络中发现的 RTSP/ONVIF 摄像头 — 用 VLC 打开或复制 URL:")));
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                    }

                    if root.admin-subview-mode == 2 && root.camera-list.length == 0 : Text {
                        text: I18n.t("Chưa có camera nào — bấm 📷 Quét camera.", "No cameras yet — press 📷 Scan Cameras.", "尚未发现摄像头 — 请点击 📷 扫描摄像头。");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 0 && root.proximity-devices.length == 0 : Text {
                        text: I18n.t("Chưa phát hiện thiết bị lân cận — bấm 🔍 Quét lân cận ngay.", "No proximity nodes yet — press 🔍 Trigger Proximity Sweep.", "尚未发现邻近设备 — 请点击 🔍 立即扫描邻近设备。");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 1 && root.behavior-profiles.length == 0 : Text {
                        text: I18n.t("Chưa có hồ sơ hành vi — hồ sơ hình thành khi thiết bị truy vấn DNS.", "No behavior profiles yet — profiles build as devices query DNS.", "暂无行为档案 — 设备发起 DNS 查询后自动生成。");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }

                    if root.admin-subview-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for pdev in root.proximity-devices : Rectangle {
                            height: 58px;
                            rh := TouchArea { }
                            if rh.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 220px;
                                    Text { text: pdev.name; font-size: 13px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                                    Text { text: (I18n.t("Hãng: ", "Vendor: ", "厂商: ")) + pdev.vendor; font-size: 11px; color: Theme.accent; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 140px;
                                    Text { text: "IP: " + pdev.ip; font-size: 12px; font-weight: 700; color: Theme.text-soft; }
                                    Text { text: "MAC: " + pdev.mac; font-size: 11px; color: Theme.text-muted; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 150px;
                                    Text { text: (I18n.t("Giao thức: ", "Proto: ", "协议: ")) + pdev.discovery-method; font-size: 11px; font-weight: 700; color: Theme.violet; overflow: elide; }
                                    Text { text: (I18n.t("Mạng nguồn: ", "Source net: ", "来源网络: ")) + pdev.network-interface; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: (I18n.t("Cổng mở: ", "Ports: ", "开放端口: ")) + pdev.open-ports-str; font-size: 11px; color: Theme.text-body; overflow: elide; }
                                    Text { text: (I18n.t("Thấy lúc: ", "Seen: ", "发现时间: ")) + pdev.last-seen; font-size: 10px; color: Theme.text-muted; }
                                }

                                Rectangle {
                                    width: 80px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: pdev.is-online ? Theme.ok-bg : Theme.gray-bg;
                                    HorizontalLayout {
                                        alignment: center;
                                         Text { text: pdev.is-online ? (I18n.t("🟢 TRỰC TUYẾN", "🟢 ONLINE", "🟢 在线")) : (I18n.t("🔴 NGOẠI TUYẾN", "🔴 OFFLINE", "🔴 离线")); font-size: 10px; font-weight: 800; color: pdev.is-online ? Theme.success : Theme.text-secondary; vertical-alignment: center; }
                                    }
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.attack-target-ip = pdev.ip;
                                    root.attack-target-name = pdev.name;
                                    root.attack-target-mac = pdev.mac;
                                    root.attack-target-vendor = pdev.vendor;
                                    root.attack-message = "";
                                    root.attack-modal-tab = 2;
                                    root.attack-mode = 1;
                                    root.attack-duration-min = 15;
                                    root.attack-modal-open = true;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "⚔ " + I18n.t("Thông báo đang chạy: ", "Active notices: ", "进行中的通告：") + root.active-attacks-count;
                            font-size: 13px;
                            font-weight: 700;
                            color: root.active-attacks-count > 0 ? Theme.danger-soft : Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: I18n.t("🗑 Hủy hết hạn", "🗑 Clear expired", "🗑 清除过期");
                            clicked => { root.refresh-admin-data(); }
                        }
                    }

                    if root.attack-history.length > 0 : ListView {
                        height: 110px;
                        for atk in root.attack-history : Rectangle {
                            height: 34px;
                            background: atk.is-warning ? Theme.warn-bg : Theme.crit-bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: atk.is-warning ? Theme.warning-deep : Theme.danger;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                spacing: 10px;
                                alignment: start;
                                Rectangle {
                                    width: 86px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: atk.is-warning ? Theme.amber-deep : Theme.danger-solid;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: atk.mode-label; font-size: 9px; font-weight: 800; color: Theme.white; vertical-alignment: center; }
                                    }
                                }
                                Text { text: atk.target; font-size: 11px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; min-width: 110px; }
                                Text { text: atk.message; font-size: 10px; color: Theme.text-soft; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: atk.window-label; font-size: 9px; color: Theme.text-secondary; vertical-alignment: center; min-width: 150px; }
                                Text { text: atk.hits-label; font-size: 10px; color: Theme.accent; vertical-alignment: center; min-width: 50px; }
                                Button {
                                    text: "✖";
                                    width: 30px;
                                    clicked => { root.cancel-attack(atk.target); }
                                }
                            }
                        }
                    }

                    if root.admin-subview-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for prof in root.behavior-profiles : Rectangle {
                            height: 58px;
                            rh2 := TouchArea { }
                            if rh2.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: prof.risk-score >= 50 ? Theme.danger : Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 14px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 180px;
                                    Text { text: prof.hostname; font-size: 13px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                                    Text { text: "IP: " + prof.ip; font-size: 11px; color: Theme.accent; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 160px;
                                    Text { text: (I18n.t("Phân loại: ", "Class: ", "分类: ")) + prof.category; font-size: 12px; font-weight: 700; color: prof.risk-score >= 50 ? Theme.danger-soft : Theme.ok-bright; }
                                    Text { text: "Burst QPS: " + prof.burst-qps; font-size: 11px; color: Theme.text-secondary; }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 180px;
                                    Text { text: (I18n.t("Tổng: ", "Total: ", "总计: ")) + prof.total-queries + (I18n.t(" | Chặn: ", " | Blocked: ", " | 拦截: ")) + prof.blocked-queries; font-size: 11px; font-weight: 600; color: Theme.text-soft; }
                                    Text { text: (I18n.t("Mối nguy: ", "Threats: ", "威胁: ")) + prof.threat-queries + (I18n.t(" mối đe dọa", " flagged", " 个威胁")); font-size: 11px; color: prof.threat-queries > 0 ? Theme.danger-soft : Theme.text-muted; }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Rectangle {
                                    width: 100px;
                                    height: 26px;
                                    border-radius: 13px;
                                    background: prof.risk-score >= 70 ? Theme.maroon : (prof.risk-score >= 40 ? Theme.brown : Theme.ok-bg);
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: (I18n.t("Rủi ro: ", "Risk: ", "风险: ")) + prof.risk-score + "/100"; font-size: 11px; font-weight: 800; color: Theme.white; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    if root.admin-subview-mode == 2 && root.camera-list.length > 0 : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: I18n.t("💡 Xem Live & mở VLC: app tự thử không-mật-khẩu + mật khẩu mặc định giúp bạn (Basic/Digest).", "💡 Live view & VLC open: the app auto-tries no-auth and default passwords for you (Basic/Digest).", "💡 实时预览和 VLC 打开：应用自动尝试无密码和默认密码（Basic/Digest）。");
                            font-size: 10px;
                            color: Theme.text-muted;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.admin-subview-mode == 2 : ListView {
                        vertical-stretch: 1;
                        for cam in root.camera-list : Rectangle {
                            height: 46px;
                            rh4 := TouchArea { }
                            if rh4.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-card-alt;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: cam.is-online ? Theme.ok-bg : Theme.gray-bg;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 10px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    min-width: 170px;
                                    Text { text: cam.vendor + "  " + cam.model; font-size: 12px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                                    Text { text: cam.source + (cam.is-online ? "  •  RTSP ✓" : "  •  RTSP ✗"); font-size: 9px; color: cam.is-online ? Theme.success : Theme.text-secondary; }
                                }

                                Text { text: cam.ip; font-size: 12px; font-weight: 700; color: Theme.text-soft; vertical-alignment: center; min-width: 120px; }
                                Text { text: cam.rtsp-url; font-size: 10px; color: Theme.accent; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }

                                Button {
                                    text: I18n.t("👁️ Xem Live", "👁️ Live View", "👁️ 实时预览");
                                    clicked => {
                                        root.camera-live-ip = cam.ip;
                                        root.camera-live-vendor = cam.vendor;
                                        root.camera-live-rtsp = cam.rtsp-url;
                                        root.camera-live-title = cam.vendor + " (" + cam.ip + ")";
                                        root.camera-live-status = "Connecting...";
                                        root.camera-live-has-frame = false;
                                        root.camera-security-status = "";
                                        root.camera-live-modal-open = true;
                                        root.start-camera-live-stream(cam.ip, "", "");
                                    }
                                }
                                Button {
                                    text: I18n.t("📋 Copy", "📋 Copy", "📋 复制");
                                    clicked => { root.copy-camera-url(cam.rtsp-url); }
                                }
                                Button {
                                    text: I18n.t("▶ Mở VLC", "▶ Open VLC", "▶ 用 VLC 打开");
                                    clicked => { root.open-camera-stream(cam.rtsp-url); }
                                }
                            }
                        }
                    }
                }
}
