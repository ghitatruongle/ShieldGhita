// 0.1.5-alpha2 Track 3: extracted from app_window.slint — the composition
// root keeps the AppWindow property surface; this file owns tab content.
import { Button, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { I18n, Theme } from "../common.slint";
import { ActiveConnection, AppConnectionGroup, ConsoleLogEntry, DomainLogGroup, LogEntry } from "../common.slint";
import { TabButton, StatCard, Spinner } from "../widgets.slint";
export component MonitorTab inherits Rectangle {
    callback clear-console-logs();
    callback clear-logs();
    in-out property <int> conn-view-mode;
    in-out property <[ActiveConnection]> connections;
    in-out property <[ConsoleLogEntry]> console-logs;
    callback export-logs();
    in-out property <string> filter-domain-text;
    in-out property <string> filter-ip-text;
    callback filter-logs(string, string, int);
    in-out property <[AppConnectionGroup]> grouped-connections;
    in-out property <[DomainLogGroup]> grouped-logs;
    in-out property <int> log-view-mode;
    in-out property <[LogEntry]> logs;
    in-out property <int> monitor-subview-mode;
    callback refresh-connections();

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: root.monitor-subview-mode == 0 ? (I18n.t("● 🚀 Tiến trình mạng", "● 🚀 Active Connections", "● 🚀 网络连接")) : (I18n.t("🚀 Tiến trình mạng", "🚀 Active Connections", "🚀 网络连接"));
                            clicked => { root.monitor-subview-mode = 0; }
                        }
                        Button {
                            text: root.monitor-subview-mode == 1 ? (I18n.t("● 🌐 Nhật ký DNS", "● 🌐 DNS Logs", "● 🌐 DNS 日志")) : (I18n.t("🌐 Nhật ký DNS", "🌐 DNS Logs", "🌐 DNS 日志"));
                            clicked => { root.monitor-subview-mode = 1; }
                        }
                        Button {
                            text: root.monitor-subview-mode == 2 ? (I18n.t("● 📋 Console hệ thống", "● 📋 System Console", "● 📋 系统控制台")) : (I18n.t("📋 Console hệ thống", "📋 System Console", "📋 系统控制台"));
                            clicked => { root.monitor-subview-mode = 2; }
                        }

                        Rectangle { width: 1px; height: 20px; background: Theme.border-strong; }

                        if root.monitor-subview-mode == 0 : Button {
                            text: I18n.t("🔄 Làm mới", "🔄 Refresh", "🔄 刷新");
                            clicked => { root.refresh-connections(); }
                        }
                        if root.monitor-subview-mode == 0 : Button {
                            text: root.conn-view-mode == 1 ? (I18n.t("📄 Xem Chi Tiết", "📄 Detailed List", "📄 详细列表")) : (I18n.t("🚀 Gom Nhóm Ứng Dụng", "🚀 Group by App", "🚀 按应用分组"));
                            clicked => { root.conn-view-mode = root.conn-view-mode == 1 ? 0 : 1; }
                        }

                        if root.monitor-subview-mode == 1 : Button {
                            text: root.log-view-mode == 1 ? (I18n.t("🌐 Dòng Thời Gian", "🌐 Timeline View", "🌐 时间线视图")) : (I18n.t("📊 Gom Nhóm Domain", "📊 Group by Domain", "📊 按域名分组"));
                            clicked => { root.log-view-mode = root.log-view-mode == 1 ? 0 : 1; }
                        }

                        if root.monitor-subview-mode == 1 : LineEdit {
                            placeholder-text: I18n.t("Lọc domain...", "Filter domain...", "筛选域名...");
                            width: 160px;
                            text <=> root.filter-domain-text;
                        }
                        if root.monitor-subview-mode == 1 : LineEdit {
                            placeholder-text: I18n.t("Lọc IP...", "Filter IP...", "筛选 IP...");
                            width: 120px;
                            text <=> root.filter-ip-text;
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("🔍 Lọc", "🔍 Filter", "🔍 筛选");
                            clicked => { root.filter-logs(root.filter-domain-text, root.filter-ip-text, -1); }
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("✖ Xóa lọc", "✖ Clear", "✖ 清除筛选");
                            clicked => {
                                root.filter-domain-text = "";
                                root.filter-ip-text = "";
                                root.filter-logs("", "", -1);
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("💾 Xuất CSV", "💾 Export CSV", "💾 导出 CSV");
                            clicked => { root.export-logs(); }
                        }
                        if root.monitor-subview-mode == 1 : Button {
                            text: I18n.t("🗑️ Xóa log", "🗑️ Clear Logs", "🗑️ 清空日志");
                            clicked => { root.clear-logs(); }
                        }
                        if root.monitor-subview-mode == 2 : Button {
                            text: I18n.t("🗑️ Xóa console log", "🗑️ Clear Console", "🗑️ 清空控制台");
                            clicked => { root.clear-console-logs(); }
                        }
                    }

                    if root.monitor-subview-mode == 0 && root.connections.length == 0 && root.grouped-connections.length == 0 : Text {
                        text: I18n.t("Chưa có kết nối mạng nào đang hoạt động — bấm 🔄 Làm mới.", "No active network connections — press 🔄 Refresh.", "暂无活动的网络连接 — 请点击 🔄 刷新。");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }

                    if root.monitor-subview-mode == 1 && root.logs.length == 0 : Text {
                        text: I18n.t("Chưa có nhật ký DNS — nhật ký sẽ hiện khi có truy vấn.", "No DNS logs yet — entries appear as queries arrive.", "暂无 DNS 日志 — 有查询时会自动显示。");
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }

                    if root.monitor-subview-mode == 0 && root.conn-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for grp in root.grouped-connections : Rectangle {
                            height: 42px;
                            rh := TouchArea { }
                            if rh.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-card-alt;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + grp.process-name; font-size: 13px; font-weight: 700; color: Theme.accent; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + grp.pid; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; min-width: 70px; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.accent-solid;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: grp.connection-count + (I18n.t(" kết nối", " conns", " 个连接")); font-size: 11px; font-weight: 700; color: Theme.white; vertical-alignment: center; }
                                    }
                                }

                                Text { text: grp.protocol-summary; font-size: 11px; font-weight: 700; color: Theme.violet; vertical-alignment: center; min-width: 55px; }
                                Text { text: "➔ " + grp.destinations-summary; font-size: 12px; color: Theme.text-soft; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: grp.state-summary; font-size: 11px; font-weight: 700; color: Theme.success-strong; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 0 && root.conn-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for conn in root.connections : Rectangle {
                            height: 38px;
                            rh2 := TouchArea { }
                            if rh2.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-card-alt;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: start;

                                Text { text: "🚀 " + conn.process-name; font-size: 13px; font-weight: 700; color: Theme.accent; vertical-alignment: center; min-width: 180px; overflow: elide; }
                                Text { text: "PID: " + conn.pid; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; min-width: 70px; }
                                Text { text: conn.protocol; font-size: 11px; font-weight: 700; color: Theme.violet; vertical-alignment: center; min-width: 45px; }
                                Text { text: conn.local-addr; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 150px; }
                                Text { text: "➔"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
                                Text { text: conn.remote-addr; font-size: 12px; color: Theme.text-primary; vertical-alignment: center; min-width: 170px; overflow: elide; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: conn.state; font-size: 11px; font-weight: 700; color: Theme.success-strong; vertical-alignment: center; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 1 && root.log-view-mode == 1 : ListView {
                        vertical-stretch: 1;
                        for glog in root.grouped-logs : Rectangle {
                            height: 36px;
                            rh3 := TouchArea { }
                            if rh3.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: glog.is-blocked ? Theme.danger-bg : Theme.bg-card-alt;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: glog.domain; font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }

                                Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.accent-solid;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.total-queries + (I18n.t(" truy vấn", " queries", " 次查询")); font-size: 11px; font-weight: 700; color: Theme.white; vertical-alignment: center; }
                                    }
                                }

                                if glog.blocked-queries > 0 : Rectangle {
                                    width: 95px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.danger-solid;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text { text: glog.blocked-queries + (I18n.t(" bị chặn", " blocked", " 次拦截")); font-size: 11px; font-weight: 700; color: Theme.white; vertical-alignment: center; }
                                    }
                                }

                                Text { text: (I18n.t("Gần nhất: ", "Last: ", "最近: ")) + glog.last-seen; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; min-width: 100px; }
                                Text { text: "IP: " + glog.last-ip; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; min-width: 95px; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 1 && root.log-view-mode == 0 : ListView {
                        vertical-stretch: 1;
                        for log in root.logs : Rectangle {
                            height: 32px;
                            rh4 := TouchArea { }
                            if rh4.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: log.is-blocked ? Theme.danger-bg : Theme.bg-card-alt;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: log.timestamp; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 80px; }
                                Text {
                                    text: log.is-blocked ? (I18n.t("[BỊ CHẶN]", "[BLOCKED]", "[已拦截]")) : (I18n.t("[CHO PHÉP]", "[ALLOWED]", "[允许]"));
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    min-width: 85px;
                                    color: log.is-blocked ? Theme.danger-soft : Theme.ok-bright;
                                }
                                Text { text: log.domain; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: log.source-ip; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; min-width: 100px; }
                            }
                        }
                    }

                    if root.monitor-subview-mode == 2 : ListView {
                        vertical-stretch: 1;
                        for clog in root.console-logs : Rectangle {
                            height: 30px;
                            rh5 := TouchArea { }
                            if rh5.has-hover : Rectangle {
                                x: 0; y: 0; width: 100%; height: 100%;
                                background: Theme.white;
                                opacity: 0.06;
                            }
                            background: Theme.bg-deep;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                Text { text: clog.time; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; min-width: 70px; }
                                Text {
                                    text: "[" + clog.level + "]";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: clog.level == "ERROR" ? Theme.danger : (clog.level == "WARN" ? Theme.warning-deep : Theme.accent);
                                    vertical-alignment: center;
                                    min-width: 65px;
                                }
                                Text { text: clog.message; font-size: 12px; color: Theme.text-body; vertical-alignment: center; overflow: elide; horizontal-alignment: start; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
}
