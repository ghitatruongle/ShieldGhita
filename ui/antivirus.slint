import { Button, ListView, CheckBox } from "std-widgets.slint";
import { I18n, QuarantineItem, Theme } from "common.slint";
import { TooltipBadge } from "widgets.slint";

component QuarantineRow inherits Rectangle {
    in property <QuarantineItem> entry;
    callback restore-entry(string);
    callback delete-entry(string);

    height: 62px;
    background: Theme.bg-card-alt;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-strong;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: "🔒 " + entry.original-name;
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: entry.original-path;
                font-size: 10px;
                font-family: "Consolas";
                color: Theme.text-muted;
                overflow: elide;
            }

            Text {
                text: entry.reason + " • " + entry.quarantined-at + " • " + entry.size-kb + " KB";
                font-size: 10px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        Button {
            text: I18n.t4("↩ Khôi phục", "↩ Restore", "↩ 恢复", "↩ Восстановить");
            clicked => { root.restore-entry(entry.entry-id); }
        }

        Button {
            text: I18n.t4("🔥 Xóa hẳn", "🔥 Delete", "🔥 删除", "🔥 Удалить");
            clicked => { root.delete-entry(entry.entry-id); }
        }
    }
}

export component AntivirusTab inherits Rectangle {
    in-out property <bool> av-realtime: false;
    in-out property <bool> av-auto-quarantine: false;
    in property <string> av-status: "";
    in property <int> signature-count: 0;
    in property <[QuarantineItem]> quarantine-list;
    in property <bool> is-busy: false;
    in-out property <bool> canary-autolock: false;
    in-out property <bool> canary-in-folders: false;
    in-out property <bool> lock-degraded: false;
    in property <bool> lock-active: false;

    callback toggle-canary-autolock(bool);
    callback toggle-canary-in-folders(bool);
    callback unlock();

    callback toggle-realtime(bool);
    callback toggle-auto-quarantine(bool);
    callback quarantine-pick();
    callback restore-entry(string);
    callback delete-entry(string);
    callback open-folder();
    callback update-signatures();

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: I18n.t4("🛡 DIỆT VIRUS & CÁCH LY", "🛡 ANTIVIRUS & QUARANTINE", "🛡 杀毒与隔离", "🛡 АНТИВИРУС И КАРАНТИН");
                    font-size: 15px;
                    font-weight: 800;
                    color: Theme.success;
                }

                Text {
                    text: I18n.t4("Bảo vệ thời gian thực • Canh ransomware (tệp mồi + khóa mạng khẩn cấp) • Cách ly mã hóa AES-256, KHÔNG xóa dữ liệu người dùng khi khôi phục", "Real-time guard • Ransomware canary + emergency lock • AES-256 encrypted quarantine, restore never destroys user data", "实时防护 • 勒索软件金丝雀+紧急断网 • AES-256 加密隔离，恢复不破坏数据", "Защита в реальном времени • Канарейка шифровальщика + аварийная блокировка • Карантин с AES-256");
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }

            Button {
                text: I18n.t4("⬇ Cập nhật chữ ký", "⬇ Update signatures", "⬇ 更新特征库", "⬇ Обновить сигнатуры");
                enabled: !root.is-busy;
                clicked => { root.update-signatures(); }
            }

            Button {
                text: I18n.t4("📂 Thư mục cách ly", "📂 Quarantine folder", "📂 隔离文件夹", "📂 Папка карантина");
                clicked => { root.open-folder(); }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            alignment: center;

            CheckBox {
                text: I18n.t4("Bảo vệ thời gian thực (Downloads, Desktop, USB)", "Real-time Guard (Downloads, Desktop, USB)", "实时防护（下载、桌面、USB）", "Защита в реальном времени (Downloads, Desktop, USB)");
                checked <=> root.av-realtime;
                toggled => { root.toggle-realtime(root.av-realtime); }
            }

            CheckBox {
                text: I18n.t4("Tự cách ly tệp nguy hiểm (CRITICAL)", "Auto-quarantine CRITICAL files", "自动隔离高危文件", "Авто-карантин CRITICAL файлов");
                checked <=> root.av-auto-quarantine;
                toggled => { root.toggle-auto-quarantine(root.av-auto-quarantine); }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                CheckBox {
                    text: I18n.t4("Tự khoá mạng khi tệp mồi bị đụng (tự mở sau 5 phút)", "Auto-lock when the canary is tampered (auto-release after 5 min)", "金丝雀被篡改时自动锁网（5 分钟后自动解除）", "Автоблокировка при вмешательстве в приманку (снятие через 5 мин)");
                    checked <=> root.canary-autolock;
                    toggled => { root.toggle-canary-autolock(root.canary-autolock); }
                }
                TooltipBadge {
                    tip: I18n.t4("Mặc định TẮT. Khi ransomware đổi tên/xoá tệp mồi hoặc sửa hàng loạt tệp theo dõi, app khóa Internet của máy và thiết bị LAN (DNS + WFP) trong 5 phút rồi tự mở; bấm Mở khoá ngay để mở sớm hơn. Khi đang khóa vẫn vào được thiết bị trong LAN.", "OFF by default. When ransomware renames/deletes the canary or mass-edits watched files, the app locks internet for this PC and LAN devices (DNS + WFP) for 5 minutes, then auto-releases; press Unlock now to release earlier. LAN devices stay reachable while locked.", "默认关闭。当勒索软件重命名/删除诱饵文件或批量修改受监控文件时，应用会锁定本机与局域网设备的网络（DNS + WFP）5 分钟后自动解除；可点“立即解锁”提前解除。锁定期间局域网设备仍可访问。", "По умолчанию ВЫКЛ. Если шифровальщик переименует/удалит приманку или массово изменит отслеживаемые файлы, приложение блокирует интернет ПК и устройств LAN (DNS + WFP) на 5 минут, затем снимает само; можно снять раньше кнопкой. Устройства LAN остаются доступны.");
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                CheckBox {
                    text: I18n.t4("Đặt tệp mồi trong thư mục theo dõi", "Place canary inside watched folders", "在受监控文件夹放置诱饵文件", "Размещать приманку в отслеживаемых папках");
                    checked <=> root.canary-in-folders;
                    toggled => { root.toggle-canary-in-folders(root.canary-in-folders); }
                }
                TooltipBadge {
                    tip: I18n.t4("Tạo tệp mồi canary.dat vô hại trong Downloads, Desktop và ổ USB để phát hiện ransomware. Tệp mồi chỉ dùng để báo động — app không xoá dữ liệu của bạn.", "Places a harmless canary.dat honeypot in Downloads, Desktop and USB drives to detect ransomware. It only raises an alarm — the app never deletes your data.", "在下载、桌面和 USB 磁盘放置无害的诱饵文件 canary.dat 以检测勒索软件。诱饵仅用于告警 — 应用绝不删除您的数据。", "Размещает безвредную приманку canary.dat в Загрузках, на Рабочем столе и USB-накопителях для обнаружения шифровальщика. Приманка только сигнализирует — приложение не удаляет ваши данные.");
                }
            }
        }

        if root.lock-active : Rectangle {
            height: 56px;
            background: Theme.danger-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.danger;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: root.lock-degraded ? (I18n.t4("⛔ KHOÁ DNS do tệp mồi bị can thiệp — chưa cắt được Internet hoàn toàn (WFP cần quyền Admin), tự mở sau 5 phút", "⛔ DNS LOCKED by a canary tamper — internet not fully cut (WFP needs Administrator), auto-releases in 5 minutes", "⛔ 因金丝雀被篡改已锁定 DNS — 未能完全断网（WFP 需管理员权限），5 分钟后自动解除", "⛔ DNS заблокирован из-за приманки — сеть не перерезана полностью (WFP требует прав администратора), снятие через 5 минут")) : (I18n.t4("⛔ Mạng đang bị KHOÁ do tệp mồi bị can thiệp — máy và thiết bị LAN mất Internet, vẫn vào được thiết bị trong LAN, tự mở sau 5 phút", "⛔ Network is LOCKED by a canary tamper — this PC and LAN devices lose internet, LAN devices stay reachable, auto-releases in 5 minutes", "⛔ 网络已因金丝雀被篡改而锁定 — 本机与局域网设备断网，局域网设备仍可访问，5 分钟后自动解除", "⛔ Сеть заблокирована из-за приманки — ПК и устройства LAN без интернета, устройства LAN доступны, снятие через 5 минут"));
                    font-size: 12px;
                    font-weight: 800;
                    color: Theme.danger-text;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    Button {
                        text: I18n.t4("🔓 Mở khoá ngay", "🔓 Unlock now", "🔓 立即解除", "🔓 Разблокировать");
                        clicked => { root.unlock(); }
                    }
                    TooltipBadge {
                        tip: I18n.t4("Gỡ khoá ngay, không chờ hết 5 phút: trả DNS về bình thường và gỡ bộ lọc WFP. Mạng máy này và thiết bị LAN trở lại như cũ.", "Releases the lock immediately instead of waiting 5 minutes: restores normal DNS and removes the WFP filters. This PC and the LAN devices get their network back.", "立即解除，无需等待 5 分钟：恢复正常 DNS 并移除 WFP 过滤器。本机与局域网设备的网络恢复如初。", "Снимает блокировку сразу, не дожидаясь 5 минут: восстанавливает DNS и удаляет фильтры WFP. ПК и устройства LAN получают сеть обратно.");
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 58px;
            alignment: center;

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-card-alt;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 8px;
                    alignment: center;

                    Text {
                        text: I18n.t4("CHỮ KÝ ĐANG HOẠT ĐỘNG", "ACTIVE SIGNATURES", "生效特征数", "АКТИВНЫХ СИГНАТУР");
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    Text {
                        text: root.signature-count;
                        font-size: 18px;
                        font-weight: 800;
                        color: Theme.accent;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg-card-alt;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 8px;
                    alignment: center;

                    Button {
                        text: root.is-busy ? I18n.t4("⏳ Đang xử lý...", "⏳ Working...", "⏳ 处理中...", "⏳ Обработка...") : I18n.t4("🔒 Cách ly tệp thủ công", "🔒 Quarantine a file manually", "🔒 手动隔离文件", "🔒 Изолировать файл вручную");
                        enabled: !root.is-busy;
                        clicked => { root.quarantine-pick(); }
                    }
                }
            }
        }

        if root.av-status != "" : Rectangle {
            height: 36px;
            background: Theme.bg-panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent-solid;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;

                Text {
                    text: root.av-status;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.accent;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: I18n.t4("🔒 DANH SÁCH CÁCH LY (mã hóa AES-256, khôi phục nguyên vẹn)", "🔒 QUARANTINE LIST (AES-256 encrypted, restorable)", "🔒 隔离列表（AES-256 加密，可恢复）", "🔒 КАРАНТИН (AES-256, восстанавливается)");
            font-size: 12px;
            font-weight: 700;
            color: Theme.text-soft;
        }

        if root.quarantine-list.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card-alt;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "✨";
                    font-size: 34px;
                    horizontal-alignment: center;
                }

                Text {
                    text: I18n.t4("Chưa có tệp nào trong cách ly. Quét vị trí hoặc để Bảo vệ Thời gian thực tự bắt tệp nguy hiểm.", "Quarantine is empty. Use Location Scan or let Real-time Guard catch malicious files.", "隔离区为空。使用位置扫描或让实时防护捕获恶意文件。", "Карантин пуст. Используйте сканирование или защиту в реальном времени.");
                    font-size: 12px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.quarantine-list.length > 0 : ListView {
            vertical-stretch: 1;
            for entry in root.quarantine-list : QuarantineRow {
                entry: entry;
                restore-entry(id) => { root.restore-entry(id); }
                delete-entry(id) => { root.delete-entry(id); }
            }
        }
    }
}
