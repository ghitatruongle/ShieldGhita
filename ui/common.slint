// Shared globals and data structures for all Shield Ghita UI files.
export global I18n {
    in-out property <int> lang: 0;
    public pure function t(vi: string, en: string, zh: string) -> string {
        return lang == 1 ? en : (lang == 2 ? zh : vi);
    }
    // Translates data-driven severity/risk tags coming from the backend.
    public pure function sev(v: string) -> string {
        return v == "CRITICAL" ? t("NGHIÊM TRỌNG", "CRITICAL", "严重")
             : v == "HIGH" ? t("CAO", "HIGH", "高")
             : v == "MEDIUM" ? t("TRUNG BÌNH", "MEDIUM", "中")
             : v == "LOW" ? t("THẤP", "LOW", "低")
             : v;
    }
}

export struct NetworkDevice {
    name: string,
    ip: string,
    mac: string,
    vendor: string,
    device-type: string,
    is-online: bool,
    latency: string,
    traffic: string,
    total-queries: int,
    blocked-queries: int,
    threats-detected: int,
    last-domain: string,
    last-active: string,
    risk-level: string,
    open-ports: string,
    port-risk: string,
    port-advice: string,
    confidence: int,
}

