    last-domain: string,
    last-active: string,
    risk-level: string,
    open-ports: string,
    port-risk: string,
    port-advice: string,
    confidence: int,
    custom-alias: string,
    os-name: string,
    is-quarantined: bool,
    bandwidth-rate: string,
    is-local: bool,
}

